<div id="ust-menu-aplikacji" class="ust-menu-aplikacji">
  <a class="oms-brand" href="<%= nawigacja.boczne?.[0]?.pozycje?.[0]?.href ?? '/' %>" aria-label="Twój OMS — strona główna"><img class="pas-logo" src="<%= zasob('favicon-192.png') %>" alt=""><span>Twój OMS</span></a>
  <nav class="ust-menu-skroty" aria-label="Skróty aplikacji">
    <% (nawigacja.boczne ?? []).flatMap(g => g.pozycje).filter(p => ['zamowienia','przesylki','faktury','magazyn'].includes(p.klucz)).forEach(p => { %>
    <a href="<%= p.href %>"><%= p.etykieta %></a>
    <% }); %>
  </nav>
  <details class="ust-menu-pelne" data-menu="aplikacja-ustawienia">
    <summary data-menu-trigger="aplikacja-ustawienia">Menu <span class="ust-menu-dopisek">aplikacji</span> <span aria-hidden="true">⌄</span></summary>
    <div class="ust-menu-panel" data-menu-panel="aplikacja-ustawienia"><%- include('_menu-panelu.ejs', {nawigacja,statusyMenu,mobilna:true}) %></div>
  </details>
</div>
