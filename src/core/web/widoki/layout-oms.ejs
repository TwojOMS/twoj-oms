<%# Ekran odmowy powstaje w onRequest, zanim istnieją locals wspólnej ramy. Jego świadomie
    samodzielny dokument pozostaje jedynym użyciem tej furtki. Kampania przechodzi niżej. %>
<% if (locals.wlasnyUklad) { %><%- body %><% } else { %>
<!doctype html>
<%# `data-motyw` siedzi na <html>, a nie na <body>: podmiana zmiennych musi objac takze */
    tlo strony i `color-scheme`, ktore przegladarka czyta z korzenia dokumentu. %>
<html lang="pl" data-motyw="<%= motyw %>">
<head>
  <link rel="icon" type="image/png" href="<%= zasob('favicon-32.png') %>">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="<%= zasob('oms-uklad.css') %>">
  <%# ⚠️ htmx — JEDYNA biblioteka po stronie przegladarki w tym panelu i jest tu po JEDNA
      rzecz: zywe szukanie w magazynie (21.08.2026). Nie pisze sie w niej JavaScriptu —
      atrybuty `hx-*` mowia, co pobrac i ktory kawalek strony podmienic, a serwer dalej
      renderuje HTML z tych samych widokow EJS. Regula „widok nic nie liczy" zostaje
      nietknieta: przegladarka nie dostaje ani jednej liczby do policzenia.

      ⚠️⚠️ WYLACZNIE NA ZADANIE WIDOKU (`htmx: true` z trasy), nigdy globalnie. Ekran zwrotu
      ma NIE MIEC ANI JEDNEGO skryptu i pilnuje tego test — bo jego dwukrokowosc bierze sie
      wlasnie stad, ze nic nie liczy sie na zywo; skrypt zrobilby z drugiego kroku ozdobe.
      Wartosc domyslna (`false`) stoi w defaultContext w web/server.js, wiec ekran dopisany
      w przyszlosci NIE dostaje biblioteki przez przypadek.

      ⚠️ Z WLASNEGO HOSTA (`/public/htmx.min.js`), nigdy z CDN-u. Panel chodzi w LAN-ie bez
      wyjscia na swiat, a plik jest ten sam, ktorego uzywa panel indywidualny — jedna kopia
      w repo, nie dwie do rozjechania. %>
  <% if (htmx) { %><script src="<%= zasob('htmx.min.js') %>"></script><% } %>
  <link rel="stylesheet" href="<%= zasob('oms-design.css') %>"><% if (typeof nawigacja !== 'undefined' && nawigacja?.kontekst?.dzial === 'ustawienia') { %>
  <link rel="stylesheet" href="<%= zasob('oms-ustawienia.css') %>"><% } %>
</head>
<body>
  <%# PRZ-085: ekran bez własnego `panelStatusow` bierze liczby z pipeline'u (`licznikiStatusow`); `locals.`, bo
      układ renderują też testy menu bez kontekstu pipeline.js. %>
  <% const licznikiWspolne = locals.licznikiStatusow ?? null;
    const statusyWzorcowe = (nawigacja?.kontekst?.statusy ?? []).map(s => licznikiWspolne && licznikiWspolne[s.klucz] !== undefined ? { ...s, liczba: licznikiWspolne[s.klucz] } : s);
    const statusyRuntime = (typeof panelStatusow !== 'undefined' && panelStatusow) ? panelStatusow : null;
    const statusyMenu = statusyRuntime
      ? [...statusyWzorcowe.map(w => statusyRuntime.find(p => p.klucz === w.klucz) ?? w), ...statusyRuntime.filter(p => !statusyWzorcowe.some(w => w.klucz === p.klucz))]
      : statusyWzorcowe;
  %>
  <% if (!bezPaska) { %>
  <% const menuUstawien = nawigacja?.kontekst?.dzial === 'ustawienia';
    const zwiniete = !menuUstawien && (locals.menuZwiniete ?? false); %>
  <div class="oms-shell<%= menuUstawien ? ' oms-shell--ustawienia' : zwiniete ? ' oms-shell--zwiniete' : '' %>">
    <aside class="oms-sidebar">
      <a class="oms-brand" href="<%= nawigacja.boczne?.[0]?.pozycje?.[0]?.href ?? '/' %>" aria-label="Twój OMS — strona główna"><img class="pas-logo" src="<%= zasob('favicon-192.png') %>" alt="<%= typeof marka !== 'undefined' ? marka.logoAlt : '' %>"><%_ if (!zwiniete) { _%><span>Twój OMS</span><%_ } else { _%><span class="oms-brand-mobile">Twój OMS</span><%_ } _%></a>
      <div class="oms-menu-desktop"><%- include('_menu-panelu.ejs', {nawigacja,statusyMenu,mobilna:false,zwiniete,ikony:menuUstawien}) %></div>
      <details class="oms-menu-mobile" data-menu="glowne">
        <summary data-menu-trigger="glowne">Menu <span aria-hidden="true">⌄</span></summary>
        <div data-menu-panel="glowne"><%- include('_menu-panelu.ejs', {nawigacja,statusyMenu,mobilna:true}) %></div>
      </details>
      <%_ if (menuUstawien) { _%>
      <details class="oms-menu-local">
        <summary class="oms-menu-toggle" aria-label="Rozwiń lub zwiń menu" title="Rozwiń lub zwiń menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4v16M10 12h10M14 8l-4 4 4 4"/></svg><span class="oms-menu-expand">Rozwiń menu</span><span class="oms-menu-collapse">Zwiń menu</span></summary>
      </details>
      <%_ } else { _%>
      <form method="post" action="/menu-boczne" class="oms-menu-toggle-form">
        <input type="hidden" name="powrot" value="<%= menuKonta?.powrot ?? (typeof sciezkaPowrotu !== 'undefined' ? sciezkaPowrotu : '/') %>">
        <button type="submit" class="oms-menu-toggle" title="<%= zwiniete ? 'Rozwiń menu' : 'Zwiń menu' %>" aria-label="<%= zwiniete ? 'Rozwiń menu' : 'Zwiń menu' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4v16M10 12h10M14 8l-4 4 4 4"/></svg><span><%= zwiniete ? 'Rozwiń menu' : 'Zwiń menu' %></span></button>
      </form>
      <%_ } _%>
    </aside>
    <%_ if (menuUstawien) { _%>
    <aside class="oms-settings-column oms-settings-navigation" aria-label="Ustawienia">
      <div class="oms-settings-heading">Ustawienia</div>
      <nav class="oms-menu" aria-label="Działy Ustawień"><ul>
        <% nawigacja.kontekst.grupy.flatMap(g => g.pozycje).forEach(p => { %>
        <li<%- p.aktywna ? ' class="aktywna"' : '' %>><a href="<%= p.href %>"<%- p.aktywna ? ' aria-current="page"' : '' %>><span><%= p.etykieta %></span><% if (p.wkrotce) { %><span class="menu-ustawien-wkrotce">wkrótce</span><% } %><% if (p.beta) { %><span class="menu-ustawien-beta">BETA</span><% } %></a></li>
        <% }); %>
      </ul></nav>
    </aside>
    <%_ } _%>
    <div class="tresc">
    <div class="oms-main" id="tresc-glowna">
      <%# PRZ-083: demo publiczne — pasek z licznikiem do resetu danych na kazdej zakladce (oms-demo.js). %>
      <%# Bez JavaScriptu mowi godzine restartu; `demo` jest null poza demo publicznym (core/demo.ts). %>
      <%# `locals.demo`, nie `demo`: uklad renderuja tez testy menu bez kontekstu pipeline.js — goly %>
      <%# identyfikator dawal tam ReferenceError (pelna bramka PRZ-083, 239 testow). %>
      <% const demo = locals.demo ?? null; %>
      <% if (demo) { %>
      <div class="pasek-demo"<% if (demo.resetPlanowy) { %> data-demo-reset="<%= demo.resetPlanowy %>" data-demo-teraz="<%= Date.now() %>" data-demo-login="<%= demo.login %>" data-demo-haslo="<%= demo.haslo %>"<% } %>>
        <span class="pasek-demo-tekst">Wersja DEMO — <% if (demo.resetPlanowy) { %>restart danych o <%= demo.resetGodzina %><% } else { %>dane wracają do stanu początkowego <%= demo.reset %><% } %></span>
        <span class="pasek-demo-dopisek">Zmiany gości znikają przy każdym restarcie.</span>
      </div>
      <% } %>
      <header class="oms-topbar">
        <div class="oms-breadcrumb"><% if (!menuUstawien) { %><span>Panel</span><span aria-hidden="true">/</span><% } %><strong><% if (typeof okruszki !== 'undefined' && Array.isArray(okruszki) && okruszki.length) { okruszki.forEach((o, i) => { if (i) { %> / <% } if (o.href) { %><a class="oms-breadcrumb-link" href="<%= o.href %>"><%= o.tekst %></a><% } else { %><%= o.tekst %><% } }); } else { %><%= title %><% } %></strong></div>
        <div class="oms-top-actions">
          <%# PRZ-102.03 (wariant C): analizy poza menu bocznym — rozwijana lista na wzór menu konta. Pozycje już %>
          <%# przefiltrowane prawami i `odlozoneEkrany` (nawigacjaDla); rola bez żadnej analizy przycisku nie dostaje. %>
          <% if (nawigacja.analizy) { %><details class="oms-menu-analiz" data-menu="analizy"><summary class="oms-menu-analiz-przycisk" data-menu-trigger="analizy"<%- nawigacja.analizy.aktywna ? ' aria-current="true"' : '' %> title="<%= nawigacja.analizy.etykieta %>"><%- include('_ikona-panelu.ejs', {klucz:'raporty'}) %><span><%= nawigacja.analizy.etykieta %></span></summary>
            <div class="oms-menu-analiz-panel" data-menu-panel="analizy"><ul><% nawigacja.analizy.pozycje.forEach(function(p) { %><li><a href="<%= p.href %>"<%- p.aktywna ? ' aria-current="page"' : '' %>><%- include('_ikona-panelu.ejs', {klucz:p.klucz}) %><span><%= p.etykieta %></span></a></li><% }); %></ul></div>
          </details><% } %>
          <% if (nawigacja.ustawienia) { %><a class="oms-theme-button oms-settings-button" href="<%= nawigacja.ustawienia.href %>"<%- nawigacja.ustawienia.aktywna ? ' aria-current="page"' : '' %> aria-label="Ustawienia" title="Ustawienia"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg></a><% } %>
          <form method="post" action="/motyw" class="oms-theme-form">
            <input type="hidden" name="powrot" value="<%= menuKonta?.powrot ?? (typeof sciezkaPowrotu !== 'undefined' ? sciezkaPowrotu : '/') %>">
            <button type="submit" class="oms-theme-button" aria-label="<%= motyw === 'ciemny' ? 'Włącz jasny motyw' : 'Włącz ciemny motyw' %>" title="<%= motyw === 'ciemny' ? 'Włącz jasny motyw' : 'Włącz ciemny motyw' %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><% if (motyw === 'ciemny') { %><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/><% } else { %><path d="M20 14A9 9 0 0 1 10 4a9 9 0 1 0 10 10Z"/><% } %></svg></button>
          </form>
          <%- include('_menu-uzytkownika.ejs', {menuKonta}) %>
        </div>
      </header>
      <% if (menuUstawien) { %>
      <div class="oms-settings-navigation oms-settings-navigation--mobile">
        <% const ekranUstawien = (nawigacja.kontekst.grupy ?? []).flatMap(g => g.pozycje).find(p => p.aktywna); %>
        <details class="oms-settings-mobile">
          <summary><span>Ustawienia<% if (ekranUstawien) { %>: <strong><%= ekranUstawien.etykieta %></strong><% } %></span></summary>
          <%- include('_nawigacja-kontekstowa.ejs', {nawigacja,statusyMenu:[],mobilna:true}) %>
        </details>
      </div>
      <% } %>
      <main class="kolumna-glowna szer-<%= locals.szerokosc ?? 'karta' %>">
        <%_ if (menuUstawien) { _%>
        <div class="oms-settings-layout">
          <div class="oms-settings-content">
            <%- include('_zakladki-ustawien.ejs', {nawigacja}) %>
        <% } %>
        <%# PRZ-083: gosc demo publicznego OGLADA Ustawienia — tresc martwa (inert), nad nia jedno zdanie. Zapis i tak %>
        <%# zatrzymuje hak podglad-demo.js (403); `inert` oszczedza gosciowi klikania w cos, co nie zadziala. %>
        <% if (locals.podgladDemo) { %>
          <p class="pas-demo">W wersji demonstracyjnej ustawienia można tylko obejrzeć — zmiany są wyłączone.</p>
          <div class="podglad-demo" inert><%- body %></div>
        <% } else { %>
        <%- body %>
        <% } %>
        <% if (menuUstawien) { %>
          </div>
        </div>
        <% } %>
      </main>
    </div>
    </div>
  </div>
  <script type="module" src="<%= zasob('oms-nawigacja.js') %>"></script>
  <% if (locals.demo?.resetPlanowy) { %><script type="module" src="<%= zasob('oms-demo.js') %>"></script><% } %>
  <% } else { %><div class="tresc"><%- body %></div><% } %>
</body>
</html>
<% } %>
