<nav class="oms-menu" aria-label="<%= mobilna ? 'Główna — telefon' : 'Główna' %>">
  <% (nawigacja.boczne ?? []).forEach(function(grupa) { %>
    <section class="oms-menu-grupa" aria-label="<%= grupa.etykieta %>">
      <h2><%= grupa.etykieta %></h2>
      <ul>
        <% grupa.pozycje.forEach(function(p) { %>
          <li><a href="<%= p.href %>"<%- p.aktywna ? ' aria-current="page"' : '' %>><%- include('_ikona-panelu.ejs', {klucz:p.klucz}) %><span><%= p.etykieta %></span></a>
            <%# PRZ-066: statusy wracają do bocznego menu, pod „Zamówienia” (prośba właściciela 13.10). %>
            <%# `data-status` tylko w wersji komputerowej — menu telefonowe stoi w tym samym HTML, %>
            <%# a licznik ma mieć w dokumencie jedno źródło (test demo liczy wystąpienia). %>
            <% if (p.klucz === 'zamowienia' && (statusyMenu ?? []).length) { %>
              <ul class="oms-statusy" aria-label="Statusy zamówień">
                <% statusyMenu.forEach(function(s) { %>
                  <li><a href="<%= s.href %>"<%- s.aktywna ? ' aria-current="page"' : '' %>><span><% if (modyfikatorStatusu(s.klucz)) { %><span class="kropka <%= modyfikatorStatusu(s.klucz) %>"></span><% } %><%= s.etykieta %></span><% if (typeof s.liczba !== 'undefined') { %><span class="licznik"<% if (!mobilna) { %> data-status="<%= s.klucz %>"<% } %>><%= s.liczba %></span><% } %></a></li>
                <% }); %>
                <li class="oms-nowe-zamowienie"><a href="/zamowienia/nowe">+ Nowe zamówienie</a></li>
              </ul>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </section>
  <% }); %>
</nav>
