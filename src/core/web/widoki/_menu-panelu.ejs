<nav class="oms-menu" aria-label="<%= mobilna ? 'Główna — telefon' : 'Główna' %>">
  <% (nawigacja.boczne ?? []).forEach(function(grupa) { %>
    <section class="oms-menu-grupa" aria-label="<%= grupa.etykieta %>">
      <% if (!locals.zwiniete || mobilna) { %><h2><%= grupa.etykieta %></h2><% } %>
      <ul>
        <% grupa.pozycje.forEach(function(p) { %>
          <%# PRZ-102.03: pozycja ze statusami dostaje klasę — na telefonie zajmuje cały wiersz siatki dwóch kolumn. %>
          <% const zeStatusami = p.klucz === 'zamowienia' && (statusyMenu ?? []).length > 0; %>
          <%_ const podmenu = zeStatusami || p.klucz === 'magazyn' || p.podmenu?.length;
             const idPodmenu = `oms-podmenu-${p.klucz}-${mobilna ? 'mobile' : 'desktop'}`;
             const domyslnie = zeStatusami || p.aktywna; _%>
          <%_ const liczba = p.klucz === 'wiadomosci' ? (locals.licznikWiadomosci ?? 0) : 0; _%>
          <li<%- zeStatusami ? ' class="oms-menu-ze-statusami"' : '' %>><a href="<%= p.href %>"<%_ if ((locals.zwiniete || locals.ikony) && !mobilna) { _%> title="<%= p.etykieta + (liczba ? ` (${liczba})` : '') %>"<%_ } _%><%- p.aktywna ? ` aria-current="${p.klucz === 'faktury' ? p.biezaca ?? 'page' : 'page'}"` : '' %>><%- include('_ikona-panelu.ejs', {klucz:p.klucz}) %><span><%= p.etykieta %></span><%_ if (liczba) { _%><span class="licznik oms-wiadomosci-licznik" aria-label="Czeka na odpowiedź: <%= liczba %>"><%= liczba %></span><%_ } _%></a>
            <%_ if (podmenu) { _%>
              <button type="button" class="oms-podmenu-przycisk" data-podmenu="<%= p.klucz %>" aria-expanded="<%= domyslnie %>" aria-controls="<%= idPodmenu %>" aria-label="<%= zeStatusami ? 'Pokaż/ukryj statusy zamówień' : p.klucz === 'magazyn' ? 'Pokaż/ukryj podmenu Magazynu' : p.klucz === 'faktury' ? 'Pokaż/ukryj podmenu Faktur' : `Pokaż/ukryj podmenu ${p.etykieta}` %>" hidden></button>
            <%_ } _%>
            <%# PRZ-066: statusy wracają do bocznego menu, pod „Zamówienia” (prośba właściciela 13.10). %>
            <%# `data-status` tylko w wersji komputerowej — menu telefonowe stoi w tym samym HTML, %>
            <%# a licznik ma mieć w dokumencie jedno źródło (test demo liczy wystąpienia). %>
            <%_ if (zeStatusami) { _%>
              <ul class="oms-statusy" id="<%= idPodmenu %>" data-podmenu-lista="zamowienia" data-podmenu-domyslnie="true" aria-label="Statusy zamówień">
                <% statusyMenu.forEach(function(s) { %>
                  <li><a href="<%= s.href %>"<%- s.aktywna ? ' aria-current="page"' : '' %>><span><% if (modyfikatorStatusu(s.klucz)) { %><span class="kropka <%= modyfikatorStatusu(s.klucz) %>"></span><% } %><span class="oms-status-etykieta"><%= s.etykieta %></span></span><% if (typeof s.liczba !== 'undefined') { %><span class="licznik"<% if (!mobilna) { %> data-status="<%= s.klucz %>"<% } %>><%= s.liczba %></span><% } %></a></li>
                <% }); %>
                <li class="oms-nowe-zamowienie"><a href="/zamowienia/nowe">+ Nowe zamówienie</a></li>
              </ul>
            <%_ } _%>
            <%_ if (p.klucz === 'magazyn') { _%>
              <ul class="oms-podmenu-lista" id="<%= idPodmenu %>" data-podmenu-lista="magazyn" data-podmenu-domyslnie="<%= domyslnie %>" aria-label="Magazyn">
                <%# PRZ-160.P3b.01: Kategorie i Marki działają — odnośniki z nawigacjaDla (podstrony). %>
                <% (p.podstrony ?? []).forEach(function(d) { %>
                  <li><a href="<%= d.href %>"<%- d.biezaca ? ` aria-current="${d.biezaca}"` : '' %>><%= d.etykieta %></a></li>
                <% }); %>
              </ul>
            <%_ } _%>
            <%_ if (p.podmenu?.length) { _%>
              <ul class="oms-podmenu-lista" id="<%= idPodmenu %>" data-podmenu-lista="<%= p.klucz %>" data-podmenu-domyslnie="<%= domyslnie %>" aria-label="<%= p.etykieta %>">
                <% p.podmenu.forEach(function(d) { %>
                  <li><a href="<%= d.href %>"<%- d.biezaca ? ` aria-current="${d.biezaca}"` : '' %>><%= d.etykieta %></a></li>
                <% }); %>
              </ul>
            <%_ } _%>
          </li>
        <% }); %>
      </ul>
    </section>
  <% }); %>
  <%# PRZ-167: analizy są pozycją „Analityka” w grupach wyżej — także na telefonie (dawniej zwinięta grupa tutaj). %>
  <%# PRZ-167 (właściciel 15.11): Ustawienia także na dole menu bocznego; ikona w górnym pasku na razie zostaje. %>
  <% if (nawigacja.ustawienia) { %>
    <section class="oms-menu-grupa oms-menu-ustawienia" aria-label="Ustawienia">
      <ul><li><a href="<%= nawigacja.ustawienia.href %>"<%_ if ((locals.zwiniete || locals.ikony) && !mobilna) { _%> title="Ustawienia"<%_ } _%><%- nawigacja.ustawienia.aktywna ? ' aria-current="page"' : '' %>><%- include('_ikona-panelu.ejs', {klucz:'ustawienia'}) %><span><%= nawigacja.ustawienia.etykieta %></span></a></li></ul>
    </section>
  <% } %>
</nav>
