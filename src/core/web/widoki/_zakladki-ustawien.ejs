<% const k = nawigacja.kontekst; const d = k.dzialy?.find(d => d.aktywna); %>
<% if (d) { %>
<%- include('_naglowek-ekranu.ejs', {tytul: d.etykieta, naglowekDzialu: true,
  akcje: d.klucz === 'wysylka' && k.aktywnaZakladka === 'paczki' ? '<a class="btn" href="/ustawienia/zamowienia-i-wysylka?dodaj=1">+ Dodaj szablon</a>' : '',
  opisHtml: d.klucz === 'automatyzacje' ? '<span class="menu-ustawien-beta">BETA</span>' : '',
  zakladki: include('_zakladki-dzialu.ejs', {k, d})}) %>
<% } %>
