<%# Ekran zwrotu — własna strona, nie sekcja na karcie. Zwroty są rzadkie, więc karta zamówienia %>
<%# nie ma rosnąć przy zdecydowanej większości zamówień, które zwrotu nie mają. Nagłówek ekranu %>
<%# pochodzi ze wspólnego fragmentu `_naglowek-ekranu.ejs`, bez własnej reguły CSS w arkuszu. %>
<%# Formularz ma dwa kroki: ten ekran (krok 1) i podgląd sumy (zwrot-podglad.ejs, krok 2). %>
<%# Trasy w src/moduly/zwroty/trasy/: formularz.js (ten ekran, podgląd, „popraw”), rejestracja.js (zapis), akcje.js (pieniądze oddane, usuń), korekty.js (korekta, odblokuj, numer ręczny); widok renderuje wspolne.js. %>

<%- include('../../../core/web/widoki/_naglowek-ekranu.ejs', {tytul: `Zwrot — zamówienie ${z.numer}`, akcje: include('_naglowek-akcje-zwrot.ejs')}) %>

<%# Błąd reguły z domena/zwrot.js (parsujZwrot) — odmowa PRZED jakimkolwiek zapisem. %>
<%# Używamy `.pasek-blokada` (istniejąca klasa błędu/blokady z arkusza panelu, oms-uklad.css), %>
<%# a nie osobnej klasy `pasek--blad` — takiej klasy w arkuszu panelu nie ma. %>
<% if (blad) { %><p class="pasek-blokada"><%= blad %></p><% } %>

<%# ⚠️⚠️ KROK 1 Z DWÓCH. Operator nie ma przepisywać z ręki kwoty przy każdej pozycji ani kwoty %>
<%# łącznej, więc ekran pokazuje ceny z zamówienia i jego wartość, a pola są JUŻ WYPEŁNIONE tym, %>
<%# co panel wie. %>
<%# %>
<%# Liczby stoją nad tabelą, pola mają wartości początkowe, a sumę liczy SERWER na kroku 2 %>
<%# (POST /zamowienia/:id/zwrot/podglad); bez tego operator dostawałby kwoty, których nie widział, %>
<%# i nie wiedziałby, ile wpisać. Widok niczego nie sumuje. %>
<%# %>
<%# Przejście do kroku 2 niczego nie zapisuje — zapis dopiero z kroku 2. %>
<%# ⚠️ ZERO JAVASCRIPTU — i to jest POWÓD, dla którego ekran ma dwa kroki, a nie ozdoba. %>
<%# ⚠️ ANI JEDNEJ nowej reguły CSS: `.kafelki`/`.kafel` są wspólne z ekranem raportów, reszta z karty. %>
<% if (formularz && mozeAdres(`/zamowienia/${z.id}/zwrot/podglad`)) { %>
<section class="panel">
  <div class="panel-glowa">
    <h2>Nowy zwrot</h2>
  </div>
  <div class="panel-cialo">
    <%# PODSUMOWANIE ZAMÓWIENIA — cztery liczby, które pozwalają wpisać kwotę zwrotu bez zgadywania. %>
    <%# Kafelki `.kafelki`/`.kafel` istnieją w arkuszu (wspólne z ekranem raportów) %>
    <%# i są gotową siatką na rząd liczb — nowego kontenera nie zakładamy. %>
    <%# %>
    <%# ⚠️ „Wartość zamówienia" to KWOTA OCZEKIWANA (domena/suma-pozycji.js), TA SAMA, której %>
    <%# pilnuje bariera kwoty przy zapisie — nie kolumna sklepu `kwota_brutto`. Liczby liczy %>
    <%# domena (domena/zwrot-formularz.js), widok ich nie sumuje. %>
    <div class="kafelki">
      <div class="kafel">
        <div class="kafel-etykieta">Wartość zamówienia</div>
        <div class="kafel-wartosc"><%= formularz.podsumowanie.zamowienieZl %> zł</div>
      </div>
      <div class="kafel">
        <div class="kafel-etykieta">W tym dostawa</div>
        <div class="kafel-wartosc"><%= formularz.podsumowanie.dostawaZl %> zł</div>
      </div>
      <div class="kafel">
        <div class="kafel-etykieta">Już zwrócono</div>
        <div class="kafel-wartosc"><%= formularz.podsumowanie.zwroconoZl %> zł</div>
      </div>
      <div class="kafel">
        <div class="kafel-etykieta">Zostało do zwrotu</div>
        <div class="kafel-wartosc"><%= formularz.podsumowanie.zostaloZl %> zł</div>
      </div>
    </div>

    <%# JEDEN formularz: pozycje, dostawa, data i powod ida razem, bo krok 2 czyta je jako %>
    <%# jedno cialo (przygotujKrok2 + parsujZwrot). %>
    <form method="post" action="/zamowienia/<%= z.id %>/zwrot/podglad">
      <input type="hidden" name="powrot" value="<%= powrot %>">
      <%# `.tab-pozycje tab-stala` — DOKLADNIE ta sama para klas, co tabela pozycji na %>
      <%# karcie (zamowienie.ejs): `tab-stala` daje staly uklad kolumn wg <colgroup>, %>
      <%# a `tab-pozycje` styluje inputy w komorkach. %>
      <table class="tab-pozycje tab-stala">
        <colgroup><col style="width:40%"><col style="width:15%"><col style="width:12%"><col style="width:15%"><col style="width:18%"></colgroup>
        <thead>
          <tr>
            <th>Pozycja</th>
            <th class="liczba">Cena jedn.</th>
            <th class="liczba">Kupiono</th>
            <th>Wraca (szt.)</th>
            <th>Kwota zwrotu</th>
          </tr>
        </thead>
        <tbody>
          <% formularz.pozycje.forEach(function (p) { %>
            <tr>
              <td>
                <%= p.nazwa %>
                <input type="hidden" name="klucz" value="<%= p.klucz %>">
                <input type="hidden" name="nazwa" value="<%= p.nazwa %>">
              </td>
              <%# Cena jednostkowa jest tu WYŁĄCZNIE informacją — przy rabacie na linię %>
              <%# cena razy sztuki NIE RÓWNA SIĘ kwocie zwrotu i o kwocie decyduje %>
              <%# `brutto_linii` (patrz kwotaZaSztukiGrosze w domena/zwrot-formularz.js). %>
              <td class="liczba"><% if (p.cenaJednZl) { %><%= p.cenaJednZl %> zł<% } else { %>—<% } %></td>
              <td class="liczba"><%= p.kupiono %></td>
              <%# ⚠️ `max` to TYLE, ILE JESZCZE MOZE WROCIC (kupiono minus sztuki zwrocone %>
              <%# wczesniej), a nie tyle, ile kupiono. Pozycja zwrocona juz w calosci ma %>
              <%# `max="0"` i nie da sie jej podniesc. Prawdziwa bariera stoi i tak %>
              <%# w `parsujZwrot` — przegladarke da sie obejsc. %>
              <td><input type="number" name="ilosc" min="0" max="<%= p.doZwrotu %>" step="1" value="<%= p.ilosc %>"></td>
              <%# ⚠️⚠️ KWOTA PODĄŻA ZA ILOŚCIĄ — i tym polem ukrytym to działa. Panel niesie na krok 2 %>
              <%# kwotę, KTÓRĄ SAM ZAPROPONOWAŁ: kwota przysłana równa propozycji znaczy „operator jej %>
              <%# nie tknął", więc krok 2 przelicza ją dla wpisanej liczby sztuk. Bez tego pola operator %>
              <%# zmieniał „Wraca (szt.)" z 3 na 1, kwoty nie ruszał i zapisywał się zwrot 100,00 zł za %>
              <%# 1 z 3 sztuk — a przy rabacie 33,33 zł nie da się policzyć w głowie, więc nie było %>
              <%# jak zauważyć pomyłki. %>
              <%# ⚠️ Kwota ZOSTAJE EDYTOWALNA: zmieniona wygrywa, a krok 2 pokazuje obie liczby. %>
              <%# Przeliczenie: przygotujKrok2 w domena/zwrot-formularz.js. %>
              <td>
                <input type="text" name="pozycja_kwota" inputmode="decimal" value="<%= p.kwotaZl %>">
                <input type="hidden" name="pozycja_kwota_propozycja" value="<%= p.propozycjaZl %>">
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <%# DOSTAWA — checkbox rozstrzyga, czy koszt dostawy wraca; pole obok mowi ILE. %>
      <%# Zaznaczony domyslnie, bo zwrot calosci zwykle obejmuje dostawe. ⚠️ Gdy dostawe %>
      <%# oddano juz we WCZESNIEJSZYM zwrocie, checkbox jest odznaczony i pole puste — %>
      <%# bariera sumy odbilaby to i tak, ale ekran nie ma proponowac czegos, co sie nie uda. %>
      <%# `.etykieta-bloku` (istniejaca klasa) oddziela tabele od reszty formularza kreska %>
      <%# i naglowkiem — bez niej checkbox przykleja sie do dolnej krawedzi tabeli. %>
      <div class="etykieta-bloku">Dostawa i szczegóły zwrotu</div>
      <div class="pola">
        <label class="pole-przelacznik">
          <input type="checkbox" name="zwroc_dostawe" value="1"<% if (formularz.dostawa.zaznaczona) { %> checked<% } %>>
          Zwróć koszt dostawy (z zamówienia)
        </label>
      </div>
      <div class="pola pola--siatka">
        <label>Kwota zwrotu dostawy<input type="text" name="kwota_dostawy" inputmode="decimal" value="<%= formularz.dostawa.kwotaZl %>"></label>
        <label>Data zwrotu<input type="date" name="data" value="<%= formularz.data %>" max="<%= dzis %>"></label>
        <label>Powód<input type="text" name="powod" value="<%= formularz.powod %>"></label>
      </div>
      <%# ⚠️⚠️ TRZY STANY DOSTAWY, NIE DWA: nic nie wróciło (cisza), wróciła CZĘŚĆ (pole dostaje %>
      <%# RESZTĘ, a zdanie mówi, skąd się wzięła), wróciła CAŁOŚĆ (drugi raz nie wraca). %>
      <%# Sklejenie dwóch ostatnich pisałoby „drugi raz nie wraca" TAKŻE przy zwrocie częściowym — %>
      <%# czyli mówiłoby nieprawdę, bo bariera przy zapisie liczy RESZTĘ i te brakujące 10,00 zł %>
      <%# z 19,00 zł przepuszcza. %>
      <%# Zdanie liczy DOMENA (formularz.dostawa.uwaga), widok je tylko wypisuje. %>
      <% if (formularz.dostawa.uwaga) { %>
        <p class="wyjasnienie"><%= formularz.dostawa.uwaga %></p>
      <% } %>
      <%# ⚠️⚠️ EKRAN NIE MA MILCZEĆ O TYM, ŻE WŁASNA PODPOWIEDŹ WEJDZIE NA WŁASNĄ BARIERĘ. %>
      <%# Zamówienie, w którym pozycje i dostawa dają więcej niż jego kwota, istnieje — bez tego %>
      <%# zdania operator dowiadywałby się o tym dopiero z odmowy po kliknięciu, za liczby, %>
      <%# których sam nie wpisał. Zdanie liczy DOMENA (formularz.ostrzezenieSumy), widok je tylko %>
      <%# wypisuje. `.pasek-uwaga` (nie `.pasek-blokada`) — to ostrzeżenie, a nie odmowa: %>
      <%# formularz zostaje używalny. %>
      <% if (formularz.ostrzezenieSumy) { %>
        <p class="pasek-uwaga"><%= formularz.ostrzezenieSumy %></p>
      <% } %>
      <p class="wyjasnienie">
        Kwoty są podpowiedziane z zamówienia i przeliczają się same, gdy zmienisz liczbę sztuk —
        popraw je, jeśli do kupującego wyszło co innego. Sumę policzy panel na następnym ekranie.
      </p>

      <div class="stopka-akcji">
        <a class="btn btn--drugi" href="<%= adresKarty %>">Wróć do zamówienia</a>
        <button type="submit" class="btn btn--glowny">Dalej — sprawdź sumę</button>
      </div>
    </form>
  </div>
</section>
<% } %>

<%# Zarejestrowane zwroty i ich ROZLICZENIE. Sekcja renderuje sie WYLACZNIE, gdy jest co %>
<%# pokazac — pusty naglowek „Zwroty" przy pierwszym wejsciu na ekran nie niesie zadnej %>
<%# informacji, a ten panel ma byc krotki. %>
<% if (z.zwroty.length) { %>
<section class="panel">
  <div class="panel-glowa">
    <h2>Zarejestrowane zwroty</h2>
  </div>
  <div class="panel-cialo">
    <% z.zwroty.forEach(function (w) { %>
      <div class="rzad">
        <span>
          <%= w.data %> — <%= w.kwota %> zł<% if (w.kwota_dostawy) { %> + dostawa <%= w.kwota_dostawy %> zł<% } %>
          <% if (w.powod) { %><small>(<%= w.powod %>)</small><% } %>
        </span>
        <span>
          <% if (w.pieniadze_oddane_at) { %>
            <%# Odznaka bez modyfikatora — dokladnie ta sama, co „potwierdzone recznie" przy %>
            <%# statusie platnosci na karcie (zamowienie.ejs). `.pastylka` nie %>
            <%# istnieje w arkuszu tego panelu. %>
            <span class="znacznik">Pieniądze oddane</span>
          <% } else if (mozeAdres(`/zamowienia/${z.id}/zwroty/${w.id}/pieniadze`)) { %>
            <form method="post" class="w-linii" action="/zamowienia/<%= z.id %>/zwroty/<%= w.id %>/pieniadze">
              <input type="hidden" name="powrot" value="<%= powrot %>">
              <button type="submit" class="btn btn--maly">Pieniądze oddane</button>
            </form>
          <% } %>
          <%# ⚠️ Przycisk „Wystaw korektę” prowadzi do trasy korekty (trasy/korekty.js), która bez podłączonego %>
          <%# serwisu korekt odmawia (503, „Wystawianie korekt nie jest skonfigurowane”). Dopóki `korektaDostepna` %>
          <%# (trasa: Boolean(korekta)) jest fałszywe, ekran ma go NIE RYSOWAĆ — przycisk, który zawsze kończy się odmową, to obietnica bez pokrycia. %>
          <%# %>
          <%# ⚠️⚠️ PRZYCISK, KTÓRY TRASA ZAWSZE ODDA NA 400, TEŻ SIĘ NIE RYSUJE. %>
          <%# Gdy inny zwrot tej faktury ma już korektę (numer albo samo %>
          <%# zlecenie), `powodOdmowyKorektyDlaFaktury` (domena/zwrot.js, przez trasę jako %>
          <%# `korektaBlokada`) odmawia KAŻDEJ próbie — panel pokazuje to samo zdanie zamiast %>
          <%# obiecywać działanie, które nie może się udać. Droga zalecana w tej sytuacji %>
          <%# („Korektę wystawiłem ręcznie") rysuje się NIEZALEŻNIE, niżej. %>
          <% if (korektaDostepna && z.faktura && !w.korekta_numer && !w.korekta_zlecona_at
            && mozeAdres(`/zamowienia/${z.id}/zwroty/${w.id}/korekta`)) { %>
            <% if (korektaBlokada[w.id]) { %>
              <span class="pasek-blokada"><%= korektaBlokada[w.id] %></span>
            <% } else if (locals.korektaBezDostawy?.[w.id]) { %>
              <%# Faktura bez pozycji „Dostawa” — przycisk wyłączony ze zdaniem z domeny zamiast gołej odmowy. %>
              <button type="button" class="btn btn--maly" disabled title="<%= korektaBezDostawy[w.id] %>">Wystaw korektę</button>
              <span class="pasek-blokada"><%= korektaBezDostawy[w.id] %></span>
            <% } else { %>
              <form method="post" class="w-linii" action="/zamowienia/<%= z.id %>/zwroty/<%= w.id %>/korekta">
                <input type="hidden" name="powrot" value="<%= powrot %>">
                <button type="submit" class="btn btn--maly">Wystaw korektę</button>
              </form>
            <% } %>
          <% } else if (w.korekta_numer) { %>
            <span class="znacznik">Korekta <%= w.korekta_numer %></span>
          <% } else if (w.korekta_zlecona_at && przepadle[w.id]) { %>
            <%# Zlecenie, które PRZEPADŁO (domena/zwrot.js: korektaPrzepadla) — %>
            <%# `201` z inFaktu nie dowodzi, że treść była poprawna, więc %>
            <%# brak numeru po progu jest jedynym sygnałem odrzucenia. WYRAŹNY błąd do %>
            <%# wyjaśnienia, nie spokojny znacznik — dlatego `.pasek-blokada` (ta sama klasa, %>
            <%# co `blad` u góry i `korekta_blad` niżej), NIE `.znacznik`. %>
            <%# %>
            <%# ⚠️⚠️ WARUNEK: DWA RÓŻNE STANY, DWA RÓŻNE ZDANIA. %>
            <%# `niePytano[w.id]` (domena/zwrot.js: korektaNieSprawdzona, przez trasę) mówi, czy %>
            <%# `doczytaj` w ogóle ZAPYTAŁ inFakt o TEN zwrot, czy sito „więcej niż jedna otwarta %>
            <%# sprawa korekty" (services/korekta.js) zatrzymało go PRZED zapytaniem. Bez tego rozróżnienia %>
            <%# ekran pisałby „inFakt nie wystawił dokumentu" NIEZALEŻNIE od tego, który to był stan — %>
            <%# czyli orzekałby o dokumencie, którego świadomie nie sprawdził. Widok TYLKO CZYTA %>
            <%# `niePytano` — regułę liczy domena. %>
            <% if (niePytano[w.id]) { %>
              <span class="pasek-blokada">
                Korekta zlecona <%= w.korekta_zlecona_at %>. Panel NIE SPRAWDZIŁ w <%= nazwaProgramu.miejscownik %>, czy
                dokument powstał — to zamówienie ma więcej niż jeden zwrot z otwartą sprawą korekty,
                a panel nie umie rozstrzygnąć, do którego zwrotu należy znaleziony dokument.
                Sprawdź sam <%= typeof gdzieProgramu !== 'undefined' ? gdzieProgramu : `w ${nazwaProgramu.miejscownik}` %>, który zwrot ma korektę, zanim zdecydujesz, co dalej.
              </span>
            <% } else { %>
              <span class="pasek-blokada">
                Korekta zlecona <%= w.korekta_zlecona_at %>, ale <%= nazwaProgramu.mianownik %> nie wystawił dokumentu —
                zlecenie zostało odrzucone. Sprawdź <%= typeof gdzieProgramu !== 'undefined' ? gdzieProgramu : `w ${nazwaProgramu.miejscownik}` %> i zgłoś to, zanim zlecisz drugie.
              </span>
            <% } %>
            <%# ⚠️⚠️ WYJŚCIE ZE STANU BEZ WYJŚCIA. Sam komunikat wyżej byłby całym końcem drogi: %>
            <%# przycisku „Wystaw korektę" już nie ma, kasowania zwrotu odmawia reguła, a zwrot %>
            <%# zostawałby nierozliczony NA ZAWSZE. Przycisk rysuje się %>
            <%# WYŁĄCZNIE w tej gałęzi — przy rezerwacji ŚWIEŻEJ zwolnienie jej dałoby DRUGĄ %>
            <%# korektę do tej samej faktury. Wzorem „Sprawdziłem w inFakcie — faktury nie ma, %>
            <%# odblokuj" na karcie zamówienia. %>
            <% if (mozeAdres(`/zamowienia/${z.id}/zwroty/${w.id}/korekta/odblokuj`)) { %>
              <form method="post" class="w-linii" action="/zamowienia/<%= z.id %>/zwroty/<%= w.id %>/korekta/odblokuj">
                <input type="hidden" name="powrot" value="<%= powrot %>">
                <button type="submit" class="btn btn--maly">Sprawdziłem w <%= nazwaProgramu.miejscownik %> — korekty nie ma, odblokuj</button>
              </form>
            <% } %>
          <% } else if (w.korekta_zlecona_at) { %>
            <span class="znacznik">Korekta zlecona — numer pojawi się po przetworzeniu</span>
            <%# Przeładowanie tego ekranu odczytuje stan zlecenia (`doczytaj` w trasie GET). %>
            <a class="btn btn--maly btn--cichy" href="<%= adresZwrotu %>">Odśwież stan</a>
          <% } %>
          <%# DRUGIE wyjście: korekta wystawiona RĘCZNIE w inFakcie. Rysuje się przy zwrocie do %>
          <%# zafakturowanego zamówienia, który numeru jeszcze nie ma — bo przy DRUGIEJ korekcie %>
          <%# do tej samej faktury jest to droga ZALECANA: panel odmawia jej świadomie %>
          <%# (services/korekta.js: nie umie odtworzyć stanu „przed"). Bez tego pola taki zwrot %>
          <%# nie rozliczyłby się nigdy. %>
          <%# %>
          <%# ⚠️⚠️ ALE NIE PRZY REZERWACJI W TOKU. Gdyby pole rysowało się TAKŻE w gałęzi %>
          <%# „Korekta zlecona — numer pojawi się po przetworzeniu": gdy zlecenie panelu jeszcze %>
          <%# się przetwarza, a człowiek w międzyczasie wystawi korektę ręcznie, powstają DWA %>
          <%# dokumenty do jednej faktury — `doczytaj` już tego nie zauważy, `odblokuj` odmówi, %>
          <%# a zwrot zamelduje się jako rozliczony. %>
          <%# Przycisk odblokowania panel chowa przed progiem z tego samego powodu; to jest ta %>
          <%# sama decyzja o tej samej wadze. Próg liczy DOMENA (`przepadle`, korektaPrzepadla), %>
          <%# a trasa odmawia niezależnie od widoku (parsujNumerKorekty) — bo druga otwarta karta %>
          <%# omija widok w całości. %>
          <% if (z.faktura && !w.korekta_numer && (!w.korekta_zlecona_at || przepadle[w.id])
            && mozeAdres(`/zamowienia/${z.id}/zwroty/${w.id}/korekta/reczna`)) { %>
            <form method="post" class="w-linii" action="/zamowienia/<%= z.id %>/zwroty/<%= w.id %>/korekta/reczna">
              <input type="hidden" name="powrot" value="<%= powrot %>">
              <label>Numer korekty z <%= nazwaProgramu.dopelniacz %><input type="text" name="numer" value=""></label>
              <button type="submit" class="btn btn--maly btn--cichy">Korektę wystawiłem ręcznie</button>
            </form>
          <% } %>
          <% if (w.korekta_blad) { %><span class="pasek-blokada"><%= w.korekta_blad %></span><% } %>
          <%# Kasowanie tylko dopóki zwrot jest świeży — regułę pilnuje trasa %>
          <%# (powodOdmowyUsunieciaZwrotu), tu tylko chowamy przycisk, który i tak dostałby odmowę. %>
          <%# `korekta_numer` osobno od `korekta_zlecona_at`: numer wpisany ręcznie istnieje BEZ %>
          <%# rezerwacji, a skasowanie takiego zwrotu zostawiałoby korektę bez podstawy. %>
          <% if (!w.pieniadze_oddane_at && !w.korekta_zlecona_at && !w.korekta_numer
            && mozeAdres(`/zamowienia/${z.id}/zwroty/${w.id}/usun`)) { %>
            <form method="post" class="w-linii" action="/zamowienia/<%= z.id %>/zwroty/<%= w.id %>/usun">
              <input type="hidden" name="powrot" value="<%= powrot %>">
              <button type="submit" class="btn btn--maly">Usuń zwrot</button>
            </form>
          <% } %>
        </span>
      </div>
    <% }); %>
  </div>
</section>
<% } %>
