<%# ⚠️⚠️ KROK 2 Z DWÓCH — „sprawdź sumę, zanim zapiszesz". %>
<%# %>
<%# Ten ekran istnieje TYLKO DLATEGO, że panel nie ma javascriptu w przeglądarce i mieć nie %>
<%# ma: sumy nie da się pokazać w trakcie wpisywania, więc pokazuje się ją po wysłaniu %>
<%# formularza. RAZEM liczy SERWER (domena/zwrot-formularz.js: razemZwrotuZl, z wyniku %>
<%# `parsujZwrot`) — widok nie sumuje niczego u siebie. %>
<%# %>
<%# ⚠️ Wszystkie wartości jadą dalej W POLACH UKRYTYCH, TAKŻE wiersze z ilością 0: to one są %>
<%# jedynym nośnikiem tego, co operator wpisał, i bez nich „Wstecz — popraw" cofałoby ręcznie %>
<%# wyzerowaną pozycję do podpowiedzi. %>
<%# %>
<%# ⚠️ ANI JEDNEJ nowej reguły CSS — `.panel`, `.tab-stala`, `.liczba`, `.stopka-akcji`, %>
<%# `.wyjasnienie`, `.btn` są już w arkuszu panelu. %>

<%- include('../../../core/web/widoki/_naglowek-ekranu.ejs', {tytul: `Zwrot — zamówienie ${z.numer}`, podtytul: 'krok 2 z 2 — sprawdź sumę', akcje: include('_naglowek-akcje-zwrot.ejs')}) %>

<section class="panel">
  <div class="panel-glowa">
    <h2>Co wraca</h2>
  </div>
  <div class="panel-cialo">
    <%# `.tab-pozycje tab-stala` — ta sama para klas, co tabela pozycji na karcie i na kroku 1. %>
    <%# Sam `tab-stala` daje tylko stały układ kolumn: bez `tab-pozycje` tabela nie ma ani %>
    <%# obramowania, ani odstępów. %>
    <table class="tab-pozycje tab-stala">
      <colgroup><col style="width:60%"><col style="width:15%"><col style="width:25%"></colgroup>
      <thead>
        <tr><th>Pozycja</th><th class="liczba">Wraca (szt.)</th><th class="liczba">Kwota</th></tr>
      </thead>
      <tbody>
        <%# Wyłącznie to, co FAKTYCZNIE wraca — pozycje z ilością 0 jadą w polach ukrytych %>
        <%# niżej, ale na tej liście nie mają czego szukać. %>
        <% kandydat.pozycje.forEach(function (p) { %>
          <tr>
            <td><%= p.nazwa %></td>
            <td class="liczba"><%= p.ilosc %></td>
            <td class="liczba"><%= p.kwota %> zł</td>
          </tr>
        <% }); %>
        <% if (!kandydat.pozycje.length) { %>
          <tr><td colspan="3">Żadna pozycja nie wraca — zwrot obejmuje wyłącznie koszt dostawy.</td></tr>
        <% } %>
        <%# DOSTAWA OSOBNO — tak samo, jak rozlicza ją korekta (osobna pozycja dokumentu), %>
        <%# więc wrzucona do jednej sumy z pozycjami myliłaby przy sprawdzaniu korekty. %>
        <tr>
          <td>Koszt dostawy</td>
          <td class="liczba">—</td>
          <td class="liczba"><% if (kandydat.kwotaDostawy) { %><%= kandydat.kwotaDostawy %> zł<% } else { %>nie wraca<% } %></td>
        </tr>
        <tr>
          <td><strong>RAZEM</strong></td>
          <td class="liczba"></td>
          <td class="liczba"><strong><%= razemZl %> zł</strong></td>
        </tr>
      </tbody>
    </table>

    <%# ⚠️⚠️ KWOTA WPISANA RĘCZNIE WYGRYWA — ALE EKRAN MA TO POWIEDZIEĆ. Kwota, której operator %>
    <%# nie tknął, przeliczyła się wyżej dla wpisanej liczby sztuk; kwota zmieniona zostaje jego %>
    <%# (np. przepisana z panelu kanału sprzedaży — to ONA jest prawdą), a tu stoi zdanie %>
    <%# z OBIEMA liczbami. %>
    <%# OSTRZEŻENIE, NIE ODMOWA: `.pasek-uwaga` (istniejąca klasa), a przycisk zapisu zostaje. %>
    <%# Zdania liczy DOMENA (domena/zwrot-formularz.js: przygotujKrok2) — widok je wypisuje. %>
    <% ostrzezenia.forEach(function (tekst) { %>
      <p class="pasek-uwaga"><%= tekst %></p>
    <% }); %>

    <p class="wyjasnienie">
      Data zwrotu: <%= kandydat.data %><% if (kandydat.powod) { %> · powód: <%= kandydat.powod %><% } %>.
      Data rządzi miesiącem podatkowym — zwrot obciąża miesiąc, w którym nastąpił.
    </p>

    <%# JEDEN formularz i DWA przyciski różniące się `formaction` — inaczej te same pola %>
    <%# ukryte trzeba by wypisać dwa razy, a dwie kopie rozjechałyby się przy pierwszej %>
    <%# zmianie formularza. `formaction` to czysty HTML, żadnego skryptu. %>
    <%# %>
    <%# ⚠️ „Wstecz" stoi PIERWSZY w kodzie ŚWIADOMIE: Enter na formularzu uruchamia pierwszy %>
    <%# przycisk zatwierdzający, a odruchowe „Enter" ma cofnąć do poprawiania, nie zapisać %>
    <%# zwrot, którego nikt jeszcze nie przeczytał. %>
    <% if (mozeAdres(`/zamowienia/${z.id}/zwrot`) || mozeAdres(`/zamowienia/${z.id}/zwrot/popraw`)) { %>
    <form method="post" action="/zamowienia/<%= z.id %>/zwrot">
      <input type="hidden" name="powrot" value="<%= powrot %>">
      <% wiersze.forEach(function (w) { %>
        <input type="hidden" name="klucz" value="<%= w.klucz_pozycji %>">
        <input type="hidden" name="nazwa" value="<%= w.nazwa %>">
        <input type="hidden" name="ilosc" value="<%= w.ilosc %>">
        <input type="hidden" name="pozycja_kwota" value="<%= w.kwota %>">
      <% }); %>
      <%# ⚠️ KWOTA ŁĄCZNA POLICZONA PRZEZ SERWER (przygotujKrok2). Bariera spójności %>
      <%# w `parsujZwrot` sprawdzi ją jeszcze raz przy zapisie — i o to chodzi: przestała %>
      <%# odrzucać operatora, a została STRAŻNIKIEM tego, że między tym ekranem a zapisem %>
      <%# nikt tych dwóch liczb nie rozjechał. %>
      <input type="hidden" name="kwota" value="<%= kwotaZl %>">
      <input type="hidden" name="kwota_dostawy" value="<%= kwotaDostawyZl %>">
      <% if (zwrocDostawe) { %><input type="hidden" name="zwroc_dostawe" value="1"><% } %>
      <input type="hidden" name="data" value="<%= kandydat.data %>">
      <input type="hidden" name="powod" value="<%= kandydat.powod || '' %>">

      <div class="stopka-akcji">
        <a class="btn btn--drugi" href="<%= adresKarty %>">Wróć do zamówienia</a>
        <% if (mozeAdres(`/zamowienia/${z.id}/zwrot/popraw`)) { %><button type="submit" class="btn btn--cichy" formaction="/zamowienia/<%= z.id %>/zwrot/popraw">Wstecz — popraw</button><% } %>
        <span class="rozpychacz"></span>
        <% if (mozeAdres(`/zamowienia/${z.id}/zwrot`)) { %><button type="submit" class="btn btn--groza">Zarejestruj zwrot</button><% } %>
      </div>
    </form>
    <% } %>
  </div>
</section>
