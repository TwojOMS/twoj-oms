<style>
    .strona-kampania {
      color-scheme: dark;
      --tlo: #0c0f14;
      --powierzchnia: rgba(21, 26, 34, .92);
      --powierzchnia-2: #1c222b;
      --ramka: rgba(255, 255, 255, .07);
      --ramka-jasna: rgba(255, 255, 255, .14);
      --tekst: #edf0f4;
      --tekst-przygaszony: #98a2b0;
      --link: #8fb6d0;
      --marka-jasna: #c3d5e2;
      --uwaga-tlo: #43371c;
      --uwaga-tekst: #e8c579;
      --uwaga-kreska: #d19a2b;
      --ok-tlo: #1f3a27;
      --ok-tekst: #8ed6a2;
      --blad-tlo: #46231a;
      --blad-tekst: #f0a48c;
      --st-nowe-tlo: #24384a;
      --st-nowe-tekst: #a8cbe8;
      --st-indyw-tlo: #1d3a36;
      --st-indyw-tekst: #8fd3c7;
      --st-zwrot-tlo: #372a44;
      --st-zwrot-tekst: #cfaee8;
      --st-anulowane-tlo: #33312c;
      --kupon-tlo: #43222f;
      --kupon-tekst: #f0a8c0;
      --kupon-ramka: #6b3a4c;
      /* Seria wykresu pieniedzy — walidator CVD: PASS na ciemnej powierzchni. */
      --w-kod: #3987e5;
      --w-utm: #d95926;
      --w-wyd: #199e70;
      --font-tekst: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      --font-liczby: "Sora", "IBM Plex Sans", system-ui, sans-serif;
      --font-mono: "IBM Plex Mono", ui-monospace, Consolas, monospace;
    }
    .strona-kampania, .strona-kampania * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    .strona-kampania {
      font-family: var(--font-tekst); margin: 0; color: var(--tekst);
      background: var(--tlo);
      /* Glebia zamiast plaskiego panelu: dwie poswiaty serii + siatka punktowa. */
      background-image:
        radial-gradient(56rem 34rem at 12% -6%, rgba(57, 135, 229, .13), transparent 60%),
        radial-gradient(44rem 30rem at 96% 4%, rgba(217, 89, 38, .09), transparent 55%),
        radial-gradient(40rem 40rem at 50% 118%, rgba(25, 158, 112, .07), transparent 60%),
        radial-gradient(rgba(255, 255, 255, .045) 1px, transparent 1.4px);
      background-size: 100% 100%, 100% 100%, 100% 100%, 26px 26px;
      background-attachment: fixed;
    }
    .strona-kampania a { color: var(--link); }
    .strona-kampania ::selection { background: rgba(57, 135, 229, .35); }

    .strona-kampania { max-width: 1560px; margin: 0 auto; padding: 1.4rem 1.6rem 4rem; }

    /* ——— wejscie sekcji (JS dodaje .na-scenie; bez JS wszystko widoczne od razu) ——— */
    .sekcja-ruch { opacity: 1; transform: none; }
    .strona-kampania.ozywiona .sekcja-ruch {
      opacity: 0; transform: translateY(14px);
      transition: opacity .55s cubic-bezier(.2, .7, .2, 1), transform .55s cubic-bezier(.2, .7, .2, 1);
    }
    .strona-kampania.ozywiona .sekcja-ruch.na-scenie { opacity: 1; transform: none; }

    /* ——— panele: szklo, obrys, uniesienie ——— */
    .panel {
      background: var(--powierzchnia);
      border: 1px solid var(--ramka); border-radius: 16px;
      overflow: hidden; margin-top: 1.15rem;
      box-shadow: 0 1px 0 rgba(255, 255, 255, .03) inset, 0 14px 34px rgba(0, 0, 0, .32);
      transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
    }
    .panel:hover { border-color: var(--ramka-jasna); }
    .panel-glowa {
      display: flex; align-items: baseline; gap: .75rem; flex-wrap: wrap;
      padding: .78rem 1.1rem; border-bottom: 1px solid var(--ramka);
      background: linear-gradient(180deg, rgba(255, 255, 255, .035), transparent);
    }
    .panel-glowa h2 {
      margin: 0; font-size: .72rem; font-weight: 600; text-transform: uppercase;
      letter-spacing: .13em; color: var(--tekst-przygaszony);
    }
    .panel-glowa .dopisek { font-size: .74rem; color: var(--tekst-przygaszony); opacity: .85; }
    /* overflow-x: szeroka tabela przewija sie WEWNATRZ panelu, zamiast rozpychac
       kolumne siatki i cala strone (zmierzone: .tab-kampania 469 px w szpalcie ~450 px
       dawala 112 px poziomego przewijania calej strony). */
    .panel-cialo { padding: 1.05rem 1.1rem; overflow-x: auto; }
    .panel-cialo > :first-child { margin-top: 0; }
    .panel-cialo > :last-child { margin-bottom: 0; }

    /* ——— naglowek kampanii ——— */
    .kampania-kod {
      font-family: var(--font-mono); letter-spacing: .02em; color: #bcd7f4;
      background: rgba(57, 135, 229, .13); border: 1px solid rgba(57, 135, 229, .35);
      padding: .1rem .55rem; border-radius: .55rem; font-size: .92em;
    }
    .kampania-okno, .kampania-wybor { margin: 0 0 .85rem; font-size: .95rem; color: var(--tekst-przygaszony); }
    .kampania-okno strong { color: var(--tekst); }
    .kampania-odswiez { margin: 0 0 1rem; }

    /* Pierscien postepu dnia kampanii — rysowany przy tekscie „dzien X z Y". */
    .pierscien-dnia { display: inline-flex; align-items: center; gap: .45rem; vertical-align: -6px; margin-left: .35rem; }
    .pierscien-dnia svg { display: block; }
    .pierscien-dnia .tor { stroke: rgba(255, 255, 255, .1); }
    .pierscien-dnia .postep {
      stroke: var(--w-kod); stroke-linecap: round; fill: none;
      filter: drop-shadow(0 0 4px rgba(57, 135, 229, .55));
      transition: stroke-dashoffset 1.1s cubic-bezier(.2, .7, .2, 1);
    }

    .strona-kampania .btn {
      display: inline-flex; align-items: center; gap: .45rem; font: inherit; font-size: .88rem;
      padding: .5rem 1rem; border-radius: .6rem;
      border: 1px solid var(--ramka-jasna); background: rgba(255, 255, 255, .05);
      color: var(--tekst); text-decoration: none; cursor: pointer;
      transition: background .15s ease, border-color .15s ease, transform .12s ease;
    }
    .strona-kampania .btn:hover { background: rgba(255, 255, 255, .1); border-color: rgba(255, 255, 255, .22); transform: translateY(-1px); }
    .strona-kampania .btn:active { transform: translateY(0); }
    .strona-kampania .btn:focus-visible { outline: 2px solid var(--w-kod); outline-offset: 2px; }
    /* Spinner po kliknieciu „Odswiez" — czysty CSS, klase .czeka dodaje skrypt. */
    form.czeka .btn { pointer-events: none; opacity: .7; }
    form.czeka .btn::before {
      content: ""; width: .85em; height: .85em; border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, .3); border-top-color: var(--tekst);
      animation: kampania-wir .7s linear infinite;
    }
    @keyframes kampania-wir { to { transform: rotate(360deg); } }

    .pasek-uwaga {
      background: linear-gradient(90deg, rgba(209, 154, 43, .16), rgba(209, 154, 43, .05));
      color: var(--uwaga-tekst); border: 1px solid rgba(209, 154, 43, .3);
      border-left: 3px solid var(--uwaga-kreska);
      padding: .6rem .85rem; border-radius: .6rem; font-size: .88rem; margin: .6rem 0;
    }
    .pusto { color: var(--tekst-przygaszony); font-style: italic; padding: .4rem 0; }
    .zrodlo-uwaga { font-size: .8rem; color: var(--tekst-przygaszony); margin: .75rem 0 0; line-height: 1.55; }

    /* ——— kafle KPI ——— */
    .kafelki { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .85rem; margin-top: 1rem; align-items: stretch; }
    .kafelki--cztery { grid-template-columns: repeat(4, 1fr); }
    @media (max-width: 940px) { .kafelki--cztery { grid-template-columns: repeat(2, 1fr); } }
    .kafel {
      position: relative; background: var(--powierzchnia-2);
      border: 1px solid var(--ramka); border-radius: 13px; padding: .85rem .95rem;
      transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
      overflow: hidden;
    }
    .kafel::after {
      content: ""; position: absolute; inset: 0 0 auto 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(57, 135, 229, .45), transparent);
      opacity: 0; transition: opacity .2s ease;
    }
    .kafel:hover { transform: translateY(-3px); border-color: var(--ramka-jasna); box-shadow: 0 10px 26px rgba(0, 0, 0, .35); }
    .kafel:hover::after { opacity: 1; }
    .kafel-etykieta { font-size: .64rem; text-transform: uppercase; letter-spacing: .12em; color: var(--tekst-przygaszony); font-weight: 600; }
    .kafel-wartosc {
      font-family: var(--font-liczby); font-size: 1.72rem; font-weight: 700; margin-top: .22rem;
      font-variant-numeric: tabular-nums; letter-spacing: -.015em; line-height: 1.15;
    }
    .kafel-dopisek { font-size: .76rem; color: var(--tekst-przygaszony); font-variant-numeric: tabular-nums; margin-top: .14rem; }

    /* ——— tabele ——— */
    table { border-collapse: collapse; width: 100%; }
    th, td { text-align: left; padding: .52rem .75rem; border-bottom: 1px solid var(--ramka); }
    th { font-size: .66rem; text-transform: uppercase; letter-spacing: .1em; color: var(--tekst-przygaszony); }
    tbody tr { transition: background .12s ease; }
    tbody tr:hover td { background: rgba(255, 255, 255, .035); }
    .liczba { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .numer-zamowienia { font-size: .98rem; font-weight: 600; text-decoration: none; color: var(--link); }
    .numer-zamowienia:hover { text-decoration: underline; }
    .wiersz-szczegoly { font-size: .77rem; color: var(--tekst-przygaszony); margin-top: .15rem; line-height: 1.45; }
    .wiersz-szczegoly-inline { font-size: .8rem; color: var(--tekst-przygaszony); font-weight: 400; }
    .przewijak-tabeli { overflow-x: auto; }

    .znacznik {
      display: inline-block; font-size: .78rem; line-height: 1.35; padding: .14rem .55rem;
      border-radius: 999px; background: rgba(255, 255, 255, .08); white-space: nowrap; color: var(--tekst);
    }
    .znacznik--nowe { background: var(--st-nowe-tlo); color: var(--st-nowe-tekst); }
    .znacznik--w-realizacji { background: var(--uwaga-tlo); color: var(--uwaga-tekst); }
    .znacznik--wyslane { background: var(--ok-tlo); color: var(--ok-tekst); }
    .znacznik--indywidualne { background: var(--st-indyw-tlo); color: var(--st-indyw-tekst); }
    .znacznik--zwrot { background: var(--st-zwrot-tlo); color: var(--st-zwrot-tekst); }
    .znacznik--anulowane { background: var(--st-anulowane-tlo); color: var(--tekst-przygaszony); }
    .znacznik--ekspres { background: var(--uwaga-tlo); color: var(--uwaga-tekst); font-weight: 700; }
    .znacznik--kupon { background: var(--kupon-tlo); color: var(--kupon-tekst); border: 1px solid var(--kupon-ramka); font-weight: 600; }

    .dwie-szpalty { display: grid; grid-template-columns: 1fr 1fr; gap: 1.15rem; align-items: start; }
    /* min-width: 0 — bez tego element siatki nie schodzi ponizej szerokosci swojej
       tresci (domyslne min-width: auto) i szeroka tabela rozpycha CALA strone,
       zamiast uruchomic wlasny przewijak z .panel-cialo. */
    .dwie-szpalty > .panel { margin-top: 1.15rem; min-width: 0; }
    @media (max-width: 1100px) { .dwie-szpalty { grid-template-columns: 1fr; } }

    /* ——— wykres uzyc (istniejacy — te same klasy, nowa szata) ——— */
    .wykres-dni { display: flex; align-items: stretch; gap: 5px; height: 190px; padding-top: 1.4rem; }
    .dzien { flex: 1; min-width: 0; display: flex; flex-direction: column; position: relative; border-radius: 6px; transition: background .12s ease; }
    .dzien:hover { background: rgba(255, 255, 255, .04); }
    .dzien-tor { flex: 1; display: flex; align-items: flex-end; }
    .dzien-slupek {
      width: 100%; border-radius: 4px 4px 0 0; min-height: 2px;
      background: linear-gradient(180deg, #cfdbe6, #9db2c4);
    }
    .dzien-etykieta { font-size: .7rem; color: var(--tekst-przygaszony); text-align: center; height: 1.1rem; margin-top: .3rem; white-space: nowrap; font-family: var(--font-mono); }
    .dzien-kwota { position: absolute; top: -1.35rem; left: 50%; transform: translateX(-50%); font-size: .78rem; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
    /* Lejek reklamy „Od wyswietlenia do zamowienia": trzy tory o stalych wysokosciach,
       kazdy z WLASNA skala (porownuje sie ksztalt, nie wysokosci miedzy torami).
       Tor zamowien uzywa kolorow serii z wykresu pieniedzy — jeden jezyk na stronie. */
    .wykres-dni--lejek { height: auto; }
    .wykres-dni--lejek .dzien--dzis { outline: 1px dashed rgba(255, 255, 255, .35); outline-offset: 2px; }
    .dzien-tor--wyswietlenia { flex: 0 0 88px; }
    .dzien-tor--klik { flex: 0 0 44px; margin-top: 4px; }
    .dzien-tor--zamowienia { flex: 0 0 44px; margin-top: 4px; }
    .dzien-slupek--wyswietlenia { background: linear-gradient(180deg, #cfdbe6, #9db2c4); }
    .dzien-slupek--klik { background: linear-gradient(180deg, #93a9bd, #64798d); }
    .slupek-zam { width: 100%; display: flex; flex-direction: column; gap: 2px; }
    .slupek-zam .dzien-slupek { min-height: 3px; border-radius: 3px; width: 100%; }
    .dzien-slupek--utm { background: linear-gradient(180deg, #eb7a45, var(--w-utm)); box-shadow: 0 0 10px rgba(217, 89, 38, .3); }
    .dzien-slupek--kod { background: linear-gradient(180deg, #5da0ef, var(--w-kod)); box-shadow: 0 0 10px rgba(57, 135, 229, .3); }
    .lejek-opis { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin-top: .95rem; font-size: .78rem; color: var(--tekst-przygaszony); }
    .lejek-opis i { display: inline-block; width: .6rem; height: .6rem; border-radius: .18rem; margin-right: .4rem; vertical-align: -1px; }
    .lp--wyswietlenia i { background: #b6c6d4; }
    .lp--klik i { background: #7b91a5; }
    .lp--kod i { background: var(--w-kod); }
    .lp--utm i { background: var(--w-utm); }

    /* ——— WYKRES „PIENIADZE DZIEN PO DNIU" ——— */
    .pieniadze { position: relative; padding-top: 1.6rem; }
    .pieniadze-tor { display: flex; gap: 6px; align-items: flex-end; }
    .pieniadze-tor--dol { align-items: flex-start; }
    .pieniadze-os { height: 2px; border-radius: 1px; margin: 0; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .3) 12%, rgba(255, 255, 255, .3) 88%, transparent); }
    .p-dzien { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; position: relative; border-radius: 6px; transition: background .12s ease; }
    .pieniadze-tor--dol .p-dzien { justify-content: flex-start; }
    .p-dzien:hover { background: rgba(255, 255, 255, .045); }
    .p-dzien--dzis { outline: 1px dashed rgba(255, 255, 255, .35); outline-offset: 2px; }
    .p-slupek { width: 100%; min-height: 0; transition: filter .15s ease, opacity .25s ease; }
    .p-slupek--utm { background: linear-gradient(180deg, #eb7a45, var(--w-utm)); border-radius: 4px 4px 0 0; margin-bottom: 2px; box-shadow: 0 0 14px rgba(217, 89, 38, .25); }
    .p-slupek--kod { background: linear-gradient(180deg, #5da0ef, var(--w-kod)); box-shadow: 0 0 14px rgba(57, 135, 229, .25); }
    .p-slupek--szczyt { border-radius: 4px 4px 0 0; }
    .p-slupek--wydatek { background: linear-gradient(180deg, var(--w-wyd), #147a58); border-radius: 0 0 4px 4px; box-shadow: 0 0 14px rgba(25, 158, 112, .22); }
    .p-kwota { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); padding-bottom: .18rem; font-size: .8rem; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; font-family: var(--font-liczby); }
    .pieniadze-tor--dol .p-kwota { bottom: auto; top: 100%; padding: .18rem 0 0; color: var(--tekst-przygaszony); }
    .p-dzien--start { border-left: 1px dashed rgba(255, 255, 255, .3); border-radius: 0 6px 6px 0; }
    .p-start-napis { position: absolute; bottom: 100%; left: .35rem; padding-bottom: 1.5rem; font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; color: var(--tekst-przygaszony); white-space: nowrap; font-family: var(--font-mono); }
    /* Strefa „przed reklamami" (etapy z fale_json): dni przed pierwszym etapem — kod
       dzialal wtedy z samego banera na stronie. Delikatne tlo + jeden podpis przy osi. */
    .p-dzien--przed { background: rgba(255, 255, 255, .035); }
    .p-przed-napis { position: absolute; bottom: .2rem; left: .35rem; font-size: .6rem; letter-spacing: .09em; text-transform: uppercase; color: var(--tekst-przygaszony); opacity: .8; white-space: nowrap; font-family: var(--font-mono); }
    .pieniadze-dni { display: flex; gap: 6px; margin-top: 1.7rem; }
    .pieniadze-dni span { flex: 1; text-align: center; font-size: .7rem; color: var(--tekst-przygaszony); font-variant-numeric: tabular-nums; font-family: var(--font-mono); }
    .pieniadze-dni span.dzis { color: var(--tekst); font-weight: 600; }
    .pieniadze-legenda { display: flex; flex-wrap: wrap; gap: .45rem 1.35rem; align-items: baseline; margin: .2rem 0 1.05rem; font-size: .82rem; color: var(--tekst-przygaszony); }
    .pieniadze-legenda > span { cursor: default; transition: color .15s ease; }
    .pieniadze-legenda > span:hover { color: var(--tekst); }
    .pieniadze-legenda i { display: inline-block; width: .68rem; height: .68rem; border-radius: .22rem; margin-right: .42rem; vertical-align: -1px; }
    .pieniadze-legenda .l-kod i { background: var(--w-kod); box-shadow: 0 0 8px rgba(57, 135, 229, .6); }
    .pieniadze-legenda .l-utm i { background: var(--w-utm); box-shadow: 0 0 8px rgba(217, 89, 38, .55); }
    .pieniadze-legenda .l-wyd i { background: var(--w-wyd); box-shadow: 0 0 8px rgba(25, 158, 112, .5); }
    .pieniadze-zwrot { margin-left: auto; color: var(--tekst-przygaszony); }
    .pieniadze-zwrot b { color: var(--tekst); font-size: 1.35rem; font-variant-numeric: tabular-nums; font-family: var(--font-liczby); }

    /* Podswietlanie serii z legendy: body[data-seria] przygasza pozostale slupki. */
    .strona-kampania[data-seria="kod"] .p-slupek:not(.p-slupek--kod),
    .strona-kampania[data-seria="utm"] .p-slupek:not(.p-slupek--utm),
    .strona-kampania[data-seria="wyd"] .p-slupek:not(.p-slupek--wydatek) { opacity: .22; }

    /* Dymek wykresow — jeden na strone, pozycjonuje skrypt. */
    #kampania-dymek {
      position: fixed; z-index: 60; display: none; pointer-events: none; max-width: 21rem;
      background: rgba(10, 13, 18, .95); border: 1px solid var(--ramka-jasna);
      -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      border-radius: .65rem; padding: .55rem .75rem;
      font-size: .8rem; line-height: 1.55; color: var(--tekst);
      box-shadow: 0 12px 30px rgba(0, 0, 0, .5);
      font-variant-numeric: tabular-nums;
    }
    #kampania-dymek .d-tytul { font-family: var(--font-mono); font-size: .72rem; color: var(--tekst-przygaszony); margin-bottom: .2rem; }

    /* Slupki rosna po wejsciu (JS ustawia transform-origin i opoznienia inline). */
    .strona-kampania.ozywiona .p-slupek, .strona-kampania.ozywiona .dzien-slupek { transform: scaleY(0); }
    .strona-kampania.ozywiona .rosnie .p-slupek, .strona-kampania.ozywiona .rosnie .dzien-slupek {
      transform: scaleY(1);
      transition: transform .6s cubic-bezier(.2, .7, .2, 1);
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .strona-kampania.ozywiona .sekcja-ruch, .strona-kampania.ozywiona .p-slupek, .strona-kampania.ozywiona .dzien-slupek { opacity: 1; transform: none; transition: none; }
      .pierscien-dnia .postep { transition: none; }
      .strona-kampania .panel, .strona-kampania .kafel, .strona-kampania .btn { transition: none; }
    }
  </style>
<div class="strona-kampania">
