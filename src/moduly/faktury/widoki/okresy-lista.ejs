<%# Lista miesiecznych okresow rozliczeniowych klientow zbiorczych (spec 2026-08-01).
    Jeden wiersz = jeden miesiac jednego klienta = jedna faktura, ktora ten klient dostanie.

    ⚠️ Widok NIE LICZY NICZEGO SAM — kwota, saldo i stan faktury sa policzone w trasie
    (web/routes/okresy.js), dokladnie ta sama zasada, co przy liscie zamowien i karcie.
    W szczegolnosci ETYKIETA ROZLICZENIA IDZIE Z `stan`, nigdy ze znaku salda: dodatnie
    saldo przed faktura to ZALICZKA, a po fakturze — NADPLATA do zwrotu. %>
<p class="wroc"><a href="/">← Wróć do listy zamówień</a></p>

<%
  // ⚠️ `MIESIACE` PRZYCHODZI Z TRASY (domain/okres-rozliczeniowy.js) — ta sama tablica,
  // z ktorej `opisOdmowy` sklada komunikat odmowy. Kopia w szablonie znaczylaby, ze odmowa
  // i ekran moga kiedys nazwac ten sam miesiac inaczej.
  const nazwaMiesiaca = (m) => MIESIACE[m - 1] ?? `miesiąc ${m}`;
  // Stan faktury OKRESU (domain/okres-rozliczeniowy.js) w slowach dla czlowieka.
  const OPIS_FAKTURY = {
    brak: 'brak',
    w_toku: 'wystawianie trwa',
    zawieszona: 'ZAWIESZONA',
    do_wyjasnienia: 'DO WYJAŚNIENIA',
    wystawiona: 'wystawiona',
  };
%>

<div class="panel">
  <div class="panel-glowa"><h2>Okresy rozliczeniowe</h2></div>
  <div class="panel-cialo">
    <table class="tab-pozycje">
      <thead>
        <tr>
          <th>Miesiąc</th><th>Klient</th><th>Stan</th>
          <th class="liczba">Zamówień</th><th class="liczba">Kwota</th>
          <th>Faktura</th><th>Rozliczenie</th>
        </tr>
      </thead>
      <tbody>
        <% okresy.forEach(function (o) { %>
          <tr>
            <td>
              <a class="numer-zamowienia" href="/okresy/<%= o.okres.id %>">
                <%= nazwaMiesiaca(o.okres.miesiac) %> <%= o.okres.rok %>
              </a>
            </td>
            <td><%= o.klient ? o.klient.nazwa : o.okres.klient_klucz %></td>
            <td><span class="znacznik"><%= o.okres.stan %></span></td>
            <%# ⚠️ Liczba zamowien i kwota licza sie z TEGO SAMEGO zbioru (bez anulowanych,
                patrz podzialZamowienOkresu) — inaczej wiersz mowilby „2 zamówienia" obok
                kwoty jednego i wygladalby na blad arytmetyki. Anulowane sa dopisane obok,
                zeby nie zniknely z ekranu bez sladu. %>
            <td class="liczba">
              <%= o.zamowienia.length %>
              <% if (o.anulowane.length) { %>
                <div class="wiersz-szczegoly">+ <%= o.anulowane.length %> anulowanych</div>
              <% } %>
            </td>
            <td class="liczba"><%= o.rozliczenie.kwotaFakturyZl ?? '—' %> zł</td>
            <td>
              <%= OPIS_FAKTURY[o.stanFaktury] ?? o.stanFaktury %><% if (o.okres.numer) { %>
                <div class="wiersz-szczegoly"><%= o.okres.numer %></div>
              <% } %>
            </td>
            <%# ⚠️ Zadne z tych zdan NIE WYNIKA ze znaku salda — wszystkie z `stan`. %>
            <%
              // ⚠️ DOMKNIECIE 1 (recenzja Zadania 9, runda 2) — ta sama zasada, co na karcie
              // okresu (web/views/okres.ejs): gdy faktura JUZ ISTNIEJE i choc jedno zamowienie
              // tego miesiaca jest dzis anulowane, kwota liczona NA BIEZACO moze byc nizsza niz
              // w chwili wystawienia, a `rozliczenie.stan` udawalby wtedy „brak faktury" albo
              // „nadplata do zwrotu" obok kolumny „Faktura", ktora w tym samym wierszu mowi
              // „wystawiona". Lista NIE MA PRAWA zaprzeczac sama sobie.
              const wbrewFakturze = o.stanFaktury !== 'brak' && o.anulowane.length > 0
                && (o.rozliczenie.stan === 'niezafakturowany' || o.rozliczenie.stan === 'nadplata');
            %>
            <td>
              <% if (o.rozliczenie.stan === 'blad') { %>
                <span class="stan-zle">nie da się policzyć</span>
              <% } else if (wbrewFakturze) { %>
                <span class="stan-zle">do wyjaśnienia</span>
              <% } else if (o.rozliczenie.stan === 'niezafakturowany') { %>
                <%= o.rozliczenie.saldoZl === '0.00' ? 'brak faktury' : `zaliczka ${o.rozliczenie.saldoZl} zł` %>
              <% } else if (o.rozliczenie.stan === 'pokryte') { %>
                <span class="stan-ok">opłacony</span>
              <% } else if (o.rozliczenie.stan === 'niedoplata') { %>
                <span class="stan-zle">brakuje <%= o.rozliczenie.saldoZl %> zł</span>
              <% } else if (o.rozliczenie.stan === 'nadplata') { %>
                nadpłata <%= o.rozliczenie.saldoZl %> zł
              <%# ⚠️ Nadplata ma WLASNA, jawna galaz. Jako galaz domyslna malowala kazdy
                  nieznany stan jako pieniadze do zwrotu — piaty stan dodany kiedys w domenie
                  obiecywalby zwrot kwoty, ktora z nadplata nie ma nic wspolnego. %>
              <% } else { %>
                <span class="stan-zle">stan nierozpoznany (<%= o.rozliczenie.stan %>)</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
        <% if (!okresy.length) { %>
          <%# Pusta lista ma POWIEDZIEC, ze jest pusta — inaczej wyglada jak ekran, ktory
              sie nie wczytal (ta sama zasada, co przy liscie zamowien). %>
          <tr><td colspan="7" class="pusto-sekcja">
            Nie ma jeszcze żadnego okresu rozliczeniowego. Pierwszy powstanie sam, przy
            pierwszym zamówieniu klienta rozliczanego zbiorczo.
          </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
