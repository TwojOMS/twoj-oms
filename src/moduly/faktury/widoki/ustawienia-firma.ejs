<h1><%= title %></h1>

<% if (zapisano) { %><div class="pas-potwierdzenie"><p><%= zapisano %></p></div><% } %>
<% if (bledy.length) { %>
  <div class="pas-uprzedzenie"><p><strong>Nie zapisano.</strong></p><ul><% bledy.forEach(function (b) { %><li><%= b %></li><% }); %></ul></div>
<% } %>

<% if (wPliku) { %>
<section class="ust-sekcja" id="firma-stan">
  <h2>Ustawiony w pliku konfiguracji</h2>
  <p>Adres firmy jest ustawiony w pliku konfiguracji serwera (<code>oms.env</code>, zmienne <code>DPD_NADAWCA_…</code>). Ten ekran go nie zmienia — adres poprawisz w tym pliku.</p>
  <div class="ust-formularz">
    <label>Nazwa</label><div class="ust-wartosc"><%= zPliku.nazwa || '—' %></div>
    <label>Ulica</label><div class="ust-wartosc"><%= zPliku.ulica || '—' %></div>
    <label>Kod pocztowy</label><div class="ust-wartosc"><%= zPliku.kod || '—' %></div>
    <label>Miasto</label><div class="ust-wartosc"><%= zPliku.miasto || '—' %></div>
    <label>Kraj</label><div class="ust-wartosc"><%= zPliku.kraj || '—' %></div>
    <label>Telefon</label><div class="ust-wartosc"><%= zPliku.phone || '—' %></div>
    <label>E-mail</label><div class="ust-wartosc"><%= zPliku.email || '—' %></div>
  </div>
  <% if (zapis) { %>
    <form method="post" action="/ustawienia/firma/usun">
      <p>W OMS-ie został też adres zapisany wcześniej na tym ekranie. Plik konfiguracji ma pierwszeństwo, więc nie jest używany.</p>
      <div class="ust-akcje"><button class="ust-przycisk grozny" type="submit">Usuń adres zapisany na ekranie</button></div>
    </form>
  <% } %>
</section>
<% } else { %>
<section class="ust-sekcja" id="firma-stan">
  <% if (zapis) { %>
    <h2>Ustawiony</h2>
    <p>Zapisał <%= zapis.kontoLogin ?? '—' %>, <%= fmtDataCzas(zapis.zmienionoAt) %>.</p>
  <% } else { %>
    <h2>Brak adresu</h2>
    <p class="pas-uprzedzenie">Bez adresu firmy OMS nie wystawi proformy ani specyfikacji i nie nada paczki DPD.</p>
  <% } %>
  <p>Ten adres stoi na proformach, specyfikacjach do paczek i potwierdzeniach wywozu jako sprzedawca, a na etykietach DPD jako nadawca. Zmiana działa od następnego dokumentu i następnej paczki.</p>
</section>

<section class="ust-sekcja">
  <h2>Dane firmy</h2>
  <form id="firma-formularz" class="ust-formularz" method="post" action="/ustawienia/firma">
    <label for="firma-nazwa">Nazwa <span class="ust-wymagane">*</span></label>
    <div><input id="firma-nazwa" name="nazwa" value="<%= pola.nazwa %>" maxlength="100" required>
      <p class="ust-pomoc">Pełna nazwa firmy, tak jak ma stać na dokumentach.</p></div>

    <label for="firma-ulica">Ulica i numer <span class="ust-wymagane">*</span></label>
    <div><input id="firma-ulica" name="ulica" value="<%= pola.ulica %>" maxlength="100" required></div>

    <label for="firma-kod">Kod pocztowy <span class="ust-wymagane">*</span></label>
    <div><input id="firma-kod" name="kod" value="<%= pola.kod %>" maxlength="12" required>
      <p class="ust-pomoc">W Polsce w postaci NN-NNN, np. 00-950.</p></div>

    <label for="firma-miasto">Miasto <span class="ust-wymagane">*</span></label>
    <div><input id="firma-miasto" name="miasto" value="<%= pola.miasto %>" maxlength="60" required></div>

    <label for="firma-kraj">Kraj <span class="ust-wymagane">*</span></label>
    <div><input id="firma-kraj" name="kraj" value="<%= pola.kraj %>" maxlength="2" required>
      <p class="ust-pomoc">Dwuliterowy kod kraju, np. PL.</p></div>

    <label for="firma-telefon">Telefon</label>
    <div><input id="firma-telefon" name="telefon" value="<%= pola.telefon %>" maxlength="20" inputmode="tel">
      <p class="ust-pomoc">Telefon nadawcy na etykiecie.</p></div>

    <label for="firma-email">E-mail</label>
    <div><input id="firma-email" type="email" name="email" value="<%= pola.email %>" maxlength="120">
      <p class="ust-pomoc">E-mail nadawcy na etykiecie.</p></div>

    <p class="ust-pelna ust-pomoc">Pola oznaczone <span class="ust-wymagane">*</span> są wymagane.</p>
    <div class="ust-pelna ust-akcje">
      <button class="btn btn--glowny" type="submit">Zapisz</button>
    </div>
  </form>
</section>
<% if (zapis) { %>
<section class="ust-sekcja">
  <h2>Usunięcie</h2>
  <form method="post" action="/ustawienia/firma/usun" onsubmit="return confirm('Usunąć adres firmy? Bez niego OMS nie wystawi proformy ani specyfikacji.')">
    <p>Bez adresu firmy OMS nie wystawi proformy ani specyfikacji i nie nada paczki DPD. Wystawione dokumenty zostają.</p>
    <div class="ust-akcje"><button class="ust-przycisk grozny" type="submit">Usuń adres firmy</button></div>
  </form>
</section>
<% } %>
<% } %>

<%# PRZ-105: domyślna stawka VAT — zapisuje tylko administrator; bez wpisu 23. %>
<section class="ust-sekcja" id="stawka-vat">
  <h2>Domyślna stawka VAT</h2>
  <% if (stawkaVat.bledy.length) { %>
    <div class="pas-uprzedzenie"><p><strong>Nie zapisano stawki.</strong></p><ul><% stawkaVat.bledy.forEach(function (b) { %><li><%= b %></li><% }); %></ul></div>
  <% } %>
  <p>Podpowiada się w każdej nowej pozycji zamówienia. Dostają ją też pozycje ze sklepu i z Allegro oraz dostawa — w zamówieniach, które nie mają jeszcze faktury. Pozycje dopisane ręcznie zachowują stawkę z chwili dopisania. Nabywca z NIP-em z innego państwa UE zawsze dostaje 0% (WDT).</p>
  <% if (stawkaVat.biezaca === '0') { %>
    <p class="pas-uprzedzenie"><strong>0% krajowe — sprawdź podstawę.</strong> Przy nabywcy z Polski faktura pójdzie do KSeF ze stawką 0%.</p>
  <% } %>
  <% if (stawkaVat.mozeZmieniac) { %>
    <form class="ust-formularz" method="post" action="<%= stawkaVat.zapis %>">
      <label for="stawka-vat-wybor">Stawka</label>
      <div><select id="stawka-vat-wybor" name="stawka">
        <% stawkaVat.stawki.forEach(function (s) { %><option value="<%= s %>"<%= s === stawkaVat.biezaca ? ' selected' : '' %>><%= s %>%</option><% }); %>
      </select></div>
      <div class="ust-pelna ust-akcje"><button class="btn btn--glowny" type="submit">Zapisz stawkę</button></div>
    </form>
  <% } else { %>
    <p>Ustawiona: <strong><%= stawkaVat.biezaca %>%</strong>. <span class="ust-pomoc">Stawkę zmienia tylko administrator.</span></p>
  <% } %>
</section>

<%# PRZ-102.20: rachunek bankowy firmy — zapisuje tylko administrator; plik (OMS_RACHUNEK / OMS_BANK) wygrywa. %>
<section class="ust-sekcja" id="rachunek-stan">
  <h2>Rachunek bankowy</h2>
  <% if (rachunek.bledy.length) { %>
    <div class="pas-uprzedzenie"><p><strong>Nie zapisano rachunku.</strong></p><ul><% rachunek.bledy.forEach(function (b) { %><li><%= b %></li><% }); %></ul></div>
  <% } %>
  <p>Ten rachunek stoi w mailach o płatności (dane do przelewu) i na proformach, a przy paczkach Allegro za pobraniem trafia do Allegro jako konto do wypłaty pobrania. Zmiana działa od następnego maila i dokumentu.</p>
  <% if (rachunek.wPliku) { %>
    <p><strong>Ustawione w pliku konfiguracji</strong> serwera (<code>oms.env</code>, zmienne <code>OMS_RACHUNEK</code> i <code>OMS_BANK</code>). Ten ekran ich nie zmienia — rachunek poprawisz w tym pliku.</p>
    <div class="ust-formularz">
      <label>Numer rachunku</label><div class="ust-wartosc"><%= rachunek.zPliku.rachunek ? rachunek.odczyt(rachunek.zPliku.rachunek) : '—' %> <span class="ust-pomoc">(ustawione w pliku konfiguracji)</span></div>
      <label>Bank</label><div class="ust-wartosc"><%= rachunek.zPliku.bank || '—' %> <span class="ust-pomoc">(ustawione w pliku konfiguracji)</span></div>
    </div>
    <% if (rachunek.zapis && rachunek.mozeZmieniac) { %>
      <form method="post" action="/ustawienia/firma/rachunek/usun">
        <p>W OMS-ie został też rachunek zapisany wcześniej na tym ekranie. Plik konfiguracji ma pierwszeństwo, więc nie jest używany.</p>
        <div class="ust-akcje"><button class="ust-przycisk grozny" type="submit">Usuń rachunek zapisany na ekranie</button></div>
      </form>
    <% } %>
  <% } else { %>
    <% if (rachunek.biezacy.rachunek) { %>
      <p>Ustawiony: <strong><%= rachunek.odczyt(rachunek.biezacy.rachunek) %></strong><% if (rachunek.biezacy.bank) { %>, <%= rachunek.biezacy.bank %><% } %>.
        <% if (rachunek.zapis) { %>Zapisał <%= rachunek.zapis.kontoLogin ?? '—' %>, <%= fmtDataCzas(rachunek.zapis.zmienionoAt) %>.<% } %></p>
    <% } else { %>
      <p class="pas-uprzedzenie"><strong>Brak rachunku.</strong> Bez niego maile o płatności idą bez danych do przelewu, OMS nie wystawi proformy, a paczka Allegro za pobraniem, która wymaga konta, nie zostanie nadana.</p>
    <% } %>
    <% if (rachunek.mozeZmieniac) { %>
      <form id="rachunek-formularz" class="ust-formularz" method="post" action="/ustawienia/firma/rachunek">
        <label for="rachunek-numer">Numer rachunku <span class="ust-wymagane">*</span></label>
        <div><input id="rachunek-numer" name="rachunek" value="<%= rachunek.pola.rachunek %>" maxlength="40" inputmode="numeric" autocomplete="off" required>
          <p class="ust-pomoc">26 cyfr (NRB). Przedrostek PL, spacje i myślniki są dozwolone — OMS sprawdza cyfry kontrolne.</p></div>

        <label for="rachunek-bank">Bank</label>
        <div><input id="rachunek-bank" name="bank" value="<%= rachunek.pola.bank %>" maxlength="100">
          <p class="ust-pomoc">Nazwa banku na proformie obok numeru rachunku.</p></div>

        <div class="ust-pelna ust-akcje">
          <button class="btn btn--glowny" type="submit">Zapisz rachunek</button>
        </div>
      </form>
      <% if (rachunek.zapis) { %>
        <form method="post" action="/ustawienia/firma/rachunek/usun" onsubmit="return confirm('Usunąć rachunek firmy? Bez niego maile o płatności pójdą bez danych do przelewu, a OMS nie wystawi proformy.')">
          <div class="ust-akcje"><button class="ust-przycisk grozny" type="submit">Usuń rachunek firmy</button></div>
        </form>
      <% } %>
    <% } else { %>
      <p class="ust-pomoc">Rachunek wpisuje i zmienia tylko administrator.</p>
    <% } %>
  <% } %>
</section>
