<%- include('../../../core/web/widoki/_naglowek-ekranu.ejs', {tytul: 'Fakturownia'}) %>
<p><a href="/ustawienia/integracje">← Moje połączenia</a></p>
<% if (zapisano) { %><div class="pas-potwierdzenie" role="status"><p><%= zapisano %></p></div><% } %>
<% if (test) { %><div class="<%= test.ok ? 'pas-potwierdzenie' : 'pas-uprzedzenie' %>" id="fakturownia-test" role="status"><p><strong><%= test.ok ? 'Działa.' : 'Nie działa.' %></strong> <%= test.tekst %></p></div><% } %>
<% if (bledy.length) { %><div class="pas-uprzedzenie" role="alert" id="fakturownia-bledy" tabindex="-1" autofocus><p><strong>Nie zapisano.</strong></p><ul><% bledy.forEach(b => { %><li><%= b %></li><% }); %></ul></div><% } %>
<%
  // PRZ-161: formularz domeny i tokenu tylko przed pierwszym podłączeniem, po „Zmień token” i po błędzie zapisu.
  const pokazFormularz = !zEnv && (!stan || zmien || bledy.length > 0);
%>

<section class="ust-sekcja" id="fakturownia-stan" aria-labelledby="fakturownia-stan-tytul">
  <h2 id="fakturownia-stan-tytul">Stan połączenia</h2>
  <% if (zEnv) { %>
    <p class="ust-stan ust-stan-ok"><strong>Podłączony z pliku konfiguracji</strong></p>
    <p>Token i domenę konta zmienia administrator serwera w pliku konfiguracji.</p>
    <details class="ust-pomoc"><summary>Dla administratora serwera</summary><p>Plik <code>oms.env</code>: <code>FAKTUROWNIA_API_TOKEN</code> i <code>FAKTUROWNIA_DOMENA</code>. Ustawienia z pliku mają pierwszeństwo.</p></details>
  <% } else if (stan) { %>
    <%# PRZ-161: „Podłączony” tylko po przyjęciu tokenu przez Fakturownię (wynik przypięty do obecnej domeny i tokenu). %>
    <% if (sprawdzenie?.stan === 'ok') { %>
      <p class="ust-stan ust-stan-ok" id="fakturownia-stan-etykieta"><strong>Podłączony</strong></p>
    <% } else if (sprawdzenie?.stan === 'odrzucony') { %>
      <p class="ust-stan ust-stan-blad" id="fakturownia-stan-etykieta"><strong>Fakturownia odrzuca token</strong></p>
      <p><%= sprawdzenie.tekst %></p>
    <% } else { %>
      <p class="ust-stan ust-stan-weryfikacja" id="fakturownia-stan-etykieta"><strong>Zapisany, niesprawdzony</strong></p>
      <p><% if (sprawdzenie?.tekst) { %><%= sprawdzenie.tekst %> <% } %>Kliknij „Sprawdź połączenie”.</p>
    <% } %>
    <dl class="ust-dane">
      <dt>Konto</dt><dd><%= stan.ustawienia?.domena ?? '—' %>.fakturownia.pl</dd>
      <dt>Token API</dt><dd><% if (koncowka) { %><span aria-label="token kończący się na <%= koncowka %>">••••<%= koncowka %></span><% } else { %>zapisany<% } %></dd>
      <dt>Zapisał</dt><dd><%= stan.kontoLogin ?? '—' %>, <%= fmtDataCzas(stan.zmienionoAt) %></dd>
      <% if (sprawdzenie?.kiedy) { %><dt>Sprawdzono</dt><dd><%= sprawdzenie.kiedy %></dd><% } %>
    </dl>
  <% } else { %>
    <p class="ust-stan"><strong>Niepodłączony</strong></p>
  <% } %>

  <% if (uruchomienie) { %>
    <div class="pas-uprzedzenie" id="fakturownia-uruchomienie">
      <% if (!uruchomienie.wybrana) { %>
        <p>Fakturownia jeszcze nie wystawia faktur. Wybierz ją w <a href="<%= uruchomienie.adresModulu %>">Moduł faktur</a> — tam uruchomisz też OMS ponownie.</p>
      <% } else if (uruchomienie.przycisk) { %>
        <p>Fakturownia jest wybrana w <a href="<%= uruchomienie.adresModulu %>">Module faktur</a>. Zacznie wystawiać faktury po ponownym uruchomieniu OMS-u.</p>
        <form method="post" action="<%= uruchomienie.przycisk.adres %>">
          <div class="ust-akcje"><button class="btn" type="submit"<% if (uruchomienie.przycisk.nieaktywny) { %> disabled<% } %>>Uruchom OMS ponownie</button><span class="ust-pomoc">Panel będzie niedostępny przez kilka sekund.</span></div>
        </form>
      <% } else if (uruchomienie.recznie) { %>
        <p>Fakturownia jest wybrana w <a href="<%= uruchomienie.adresModulu %>">Module faktur</a>. Zacznie wystawiać faktury po ponownym uruchomieniu OMS-u na serwerze (np. <code>docker compose restart oms</code>).</p>
      <% } else { %>
        <p>Fakturownia jest wybrana w <a href="<%= uruchomienie.adresModulu %>">Module faktur</a>. Zacznie wystawiać faktury po ponownym uruchomieniu OMS-u — uruchamia administrator.</p>
      <% } %>
    </div>
  <% } %>

  <% if (pokazFormularz) { %>
  <form id="fakturownia-formularz" class="ust-formularz" method="post" action="/ustawienia/integracje/fakturownia" aria-label="<%= stan ? 'Zmień token lub konto Fakturowni' : 'Podłącz Fakturownię' %>">
    <% if (stan) { %><h3 class="ust-pelna">Zmień token lub konto</h3><% } %>
    <label for="fakturownia-domena">Domena konta <span class="ust-wymagane">*</span></label>
    <div><input id="fakturownia-domena" name="domena" value="<%= domenaProby ?? domenaWpisana ?? stan?.ustawienia?.domena ?? '' %>" pattern="[a-z0-9][a-z0-9\-]{0,62}" maxlength="63" required<% if (domenaProby) { %> readonly<% } %> autocorrect="off" autocapitalize="none" spellcheck="false" aria-describedby="fakturownia-domena-pomoc">
      <p class="ust-pomoc" id="fakturownia-domena-pomoc"><% if (domenaProby) { %>Piaskownica: konto próbne z pliku profilu. Domeny nie da się tu zmienić.<% } else { %>Część adresu przed .fakturownia.pl — małe litery, cyfry i myślnik.<% } %></p></div>
    <label for="fakturownia-token">Token API <span class="ust-wymagane">*</span></label>
    <div><input id="fakturownia-token" type="password" name="token" value="" maxlength="200" minlength="12" autocomplete="new-password" aria-describedby="fakturownia-token-pomoc"<% if (stan?.zapisaneSekrety?.token) { %> placeholder="zapisany — wpisz nowy, żeby zmienić"<% } else { %> required<% } %>>
      <p class="ust-pomoc" id="fakturownia-token-pomoc">Token z Fakturowni: Ustawienia konta → Integracja → Kod autoryzacyjny API.<% if (stan) { %> Puste pole zostawia zapisany token.<% } %></p></div>
    <div class="ust-pelna ust-akcje"><button class="btn btn--glowny" type="submit"><%= stan ? 'Zapisz' : 'Podłącz' %></button><% if (stan) { %><a class="btn" href="/ustawienia/integracje/fakturownia">Anuluj</a><% } %></div>
  </form>
  <% } %>

  <% if (zEnv || stan) { %>
  <div class="ust-akcje ust-akcje-polaczenia">
    <% if (stan && !zEnv && !pokazFormularz) { %><a class="btn" href="/ustawienia/integracje/fakturownia?zmien=1#fakturownia-formularz">Zmień token</a><% } %>
    <form method="post" action="/ustawienia/integracje/fakturownia/sprawdz"><button class="btn" type="submit">Sprawdź połączenie</button></form>
    <% if (stan) { %><form method="post" action="/ustawienia/integracje/fakturownia/odlacz" aria-describedby="fakturownia-odlaczenie"><button class="btn btn--groza" type="submit">Odłącz</button></form><% } %>
  </div>
  <p class="ust-pomoc" id="fakturownia-odlaczenie">Sprawdzenie czyta listę faktur — niczego nie wystawia ani nie wysyła do KSeF.<% if (stan) { %> Odłączenie usuwa token i domenę z OMS-u; faktury w Fakturowni i ich numery w zamówieniach zostają.<% if (zEnv) { %> Ustawienia z pliku nadal obowiązują.<% } %><% } %></p>
  <% } %>
</section>

<section class="ust-sekcja" id="fakturownia-ksef-sekcja" aria-labelledby="fakturownia-ksef">
  <h2 id="fakturownia-ksef">Automatyczna wysyłka do KSeF w Fakturowni</h2>
  <% if (alarm.length) { %>
    <p class="ust-stan ust-stan-blad"><strong>Alarm: Fakturownia sama wysłała dokumenty do KSeF.</strong></p>
    <ul><% alarm.forEach(w => { %><li>Dokument: <%= w.numer ?? w.dokument ?? 'nieznany' %>, stan: <%= w.gov_status %>, kiedy: <%= w.kiedy || 'nieznane' %>.</li><% }); %></ul>
    <p>Wyłącz automatyczną wysyłkę w <a href="<%= adresKsef %>" target="_blank" rel="noopener noreferrer">ustawieniach KSeF w Fakturowni ↗</a>, potem potwierdź tutaj.</p>
  <% } else if (potwierdzono) { %>
    <p class="ust-stan ust-stan-ok"><strong>Wyłączona</strong></p>
    <p>Potwierdzono <%= potwierdzono %>. Jeśli Fakturownia mimo to wyśle fakturę do KSeF sama, pojawi się tu alarm.</p>
  <% } else { %>
    <div class="pas-uprzedzenie"><p>Zanim wystawisz pierwszą fakturę, wyłącz w Fakturowni automatyczną wysyłkę: Ustawienia → Integracje i dodatki → KSeF → Ustawienia, suwak „Automatycznie wysyłaj tworzone dokumenty do KSeF” = wyłączony. Inaczej Fakturownia wyśle fakturę do KSeF sama, bez podglądu w OMS-ie, a dokumentu w KSeF nie da się skasować.</p></div>
  <% } %>
  <% if (alarm.length || !potwierdzono) { %>
  <div class="ust-akcje">
    <% if (!alarm.length) { %><a class="btn" href="<%= adresKsef %>" target="_blank" rel="noopener noreferrer">Otwórz ustawienia KSeF w Fakturowni ↗</a><% } %>
    <form method="post" action="/ustawienia/integracje/fakturownia/sprawdzilem" aria-labelledby="fakturownia-ksef"><button class="btn" type="submit">Sprawdziłem — automatyczna wysyłka wyłączona</button></form>
  </div>
  <p class="ust-pomoc"><a href="<%= pomocKsef %>" target="_blank" rel="noopener noreferrer">Instrukcja w pomocy Fakturowni ↗</a></p>
  <% } %>
</section>
