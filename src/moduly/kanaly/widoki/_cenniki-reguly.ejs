<%
  // PRZ-160 E3d.02-02 (plan docs/plany/PRZ-160-e3d-02.md, D1, D4): tabela reguł „cennik według rozmiaru” w kroku
  // „Oferty” Allegro i ERLI. Bez JS: zapisane wiersze plus dwa puste; kolejność reguł = kolejność wierszy od góry.
  // Pola `cennikDostaw` tu nie ma — alias D4 zamieniłby listę reguł na jeden cennik.
  // Parametry: prefiks (id), zapisane (reguły z bazy: mm i g), wyslane (odrzucony formularz albo null),
  // bledy (błędy pól: `regula-<i>`, `cennikWiekszych`), opcje (lista cenników Allegro albo null = tekst dowolny).
  const tekstPola = (v) => typeof v === 'string' ? v : '';
  const listaPola = (v) => Array.isArray(v) ? v.map(tekstPola) : v === undefined || v === null ? [] : [tekstPola(v)];
  const cm = (mm) => Number.isInteger(mm) && mm > 0 ? String(Number((mm / 10).toFixed(1))).replace('.', ',') : '';
  const kg = (g) => Number.isInteger(g) && g > 0 ? String(Number((g / 1000).toFixed(3))).replace('.', ',') : '';
  const pusty = () => ({a: '', b: '', c: '', waga: '', cennik: ''});
  let wiersze, wieksze;
  if (wyslane && typeof wyslane === 'object' && 'cennikWiekszych' in wyslane) {
    const [pa, pb, pc, pw, pk] = ['regulaA', 'regulaB', 'regulaC', 'regulaWaga', 'regulaCennik'].map((p) => listaPola(wyslane[p]));
    const n = Math.max(pa.length, pb.length, pc.length, pw.length, pk.length);
    wiersze = Array.from({length: n}, (_, i) => ({a: pa[i] ?? '', b: pb[i] ?? '', c: pc[i] ?? '', waga: pw[i] ?? '', cennik: pk[i] ?? ''}));
    wieksze = tekstPola(wyslane.cennikWiekszych);
  } else {
    const lista = Array.isArray(zapisane) ? zapisane : [];
    wiersze = lista.slice(0, -1).map((r) => ({a: cm(r?.doMm?.[0]), b: cm(r?.doMm?.[1]), c: cm(r?.doMm?.[2]), waga: kg(r?.doG), cennik: tekstPola(r?.cennik)}));
    wieksze = lista.length ? tekstPola(lista[lista.length - 1]?.cennik) : '';
    wiersze.push(...[0, 1].map(pusty));
  }
  const pozycje = Array.isArray(opcje) ? opcje : null;
  const pierwszy = Object.keys(bledy ?? {})[0];
  const blad = (klucz) => (bledy ?? {})[klucz];
  // Pole z błędem: opis błędu, aria-invalid i — przy pierwszym błędzie formularza — autofocus.
  const aria = (klucz, autofocus) => blad(klucz)
    ? ` aria-describedby="${prefiks}-${klucz}-blad" aria-invalid="true"` + (autofocus && klucz === pierwszy ? ' autofocus' : '')
    : '';
  const wymaganeWieksze = pozycje === null || pozycje.length > 0;
%>
<fieldset class="ust-cenniki" aria-describedby="<%= prefiks %>-pomoc">
  <legend>Cennik dostaw według rozmiaru</legend>
  <p id="<%= prefiks %>-pomoc" class="ust-pomoc">OMS sprawdza wiersze od góry i bierze pierwszy, w którym produkt się mieści — wymiary w dowolnym ułożeniu i waga. Większy od wszystkich dostaje cennik „dla większych”. Bez wierszy rozmiaru „dla większych” to jeden cennik dla wszystkich ofert. Pusty wiersz jest pomijany; kolejne wiersze dopiszesz po zapisie.</p>
  <p id="<%= prefiks %>-inpost" class="ust-pomoc">Podpowiedź — gabaryty paczkomatu InPost: A 8×38×64, B 19×38×64, C 41×38×64 cm, do 25 kg. OMS ich nie pilnuje; limity wpisujesz sam, tak jak ma je Twój cennik.</p>
  <% if (pozycje !== null && !pozycje.length) { %><p class="ust-pomoc">Lista cenników jest pusta — najpierw pobierz listy z Allegro (sekcja wyżej).</p><% } %>
  <div class="przewijak-tabeli">
    <table class="erli-metody ust-cenniki-tabela">
      <thead><tr><th scope="col">#</th><th scope="col">Do wymiarów (cm)</th><th scope="col">Do wagi (kg)</th><th scope="col">Cennik</th></tr></thead>
      <tbody>
      <% wiersze.forEach((w, i) => { const id = prefiks + '-' + i, klucz = 'regula-' + i, nr = i + 1; %>
        <tr<% if (blad(klucz)) { %> class="ust-cenniki-zly"<% } %>>
          <th scope="row"><%= nr %></th>
          <td><span class="ust-cenniki-wymiary">
            <% [['a', 'wymiar 1'], ['b', 'wymiar 2'], ['c', 'wymiar 3']].forEach(([pole, napis], j) => { %><% if (j) { %><span aria-hidden="true">×</span><% } %>
            <span class="ust-cenniki-pole"><label for="<%= id %>-<%= pole %>" class="ust-cenniki-etykieta"><span class="ust-cenniki-nr">Reguła <%= nr %>: </span><%= napis %> (cm)</label><input id="<%= id %>-<%= pole %>" name="regula<%= pole.toUpperCase() %>" inputmode="decimal" autocomplete="off" value="<%= w[pole] %>"<%- aria(klucz, j === 0) %>></span>
            <% }) %>
          </span></td>
          <td><span class="ust-cenniki-pole"><label for="<%= id %>-waga" class="ust-cenniki-etykieta"><span class="ust-cenniki-nr">Reguła <%= nr %>: </span>waga do (kg)</label><input id="<%= id %>-waga" name="regulaWaga" inputmode="decimal" autocomplete="off" value="<%= w.waga %>"<%- aria(klucz, false) %>></span></td>
          <td><span class="ust-cenniki-pole"><label for="<%= id %>-cennik" class="ust-cenniki-etykieta"><span class="ust-cenniki-nr">Reguła <%= nr %>: </span>cennik</label>
            <% if (pozycje) { %><select id="<%= id %>-cennik" name="regulaCennik"<%- aria(klucz, false) %>>
              <option value="">Wybierz z listy</option>
              <% for (const x of pozycje) { %><option value="<%= x.id %>"<% if (x.id === w.cennik) { %> selected<% } %>><%= x.nazwa %></option><% } %>
              <% if (w.cennik && !pozycje.some((x) => x.id === w.cennik)) { %><option value="<%= w.cennik %>" selected><%= w.cennik %> (nie ma na pobranej liście)</option><% } %>
            </select>
            <% } else { %><input id="<%= id %>-cennik" name="regulaCennik" type="text" autocomplete="off" value="<%= w.cennik %>"<%- aria(klucz, false) %>><% } %></span>
            <% if (blad(klucz)) { %><span id="<%= prefiks %>-<%= klucz %>-blad" class="ust-cenniki-blad"><%= blad(klucz) %></span><% } %></td>
        </tr>
      <% }) %>
        <tr class="ust-cenniki-wieksze<% if (blad('cennikWiekszych')) { %> ust-cenniki-zly<% } %>">
          <th scope="row">—</th>
          <td colspan="2">dla większych</td>
          <td><span class="ust-cenniki-pole"><label for="<%= prefiks %>-wieksze" class="ust-cenniki-etykieta">Cennik dla większych (wymagany)</label>
            <% if (pozycje) { %><select id="<%= prefiks %>-wieksze" name="cennikWiekszych"<% if (wymaganeWieksze) { %> required<% } %><%- aria('cennikWiekszych', true) %>>
              <option value="">Wybierz z listy</option>
              <% for (const x of pozycje) { %><option value="<%= x.id %>"<% if (x.id === wieksze) { %> selected<% } %>><%= x.nazwa %></option><% } %>
              <% if (wieksze && !pozycje.some((x) => x.id === wieksze)) { %><option value="<%= wieksze %>" selected><%= wieksze %> (nie ma na pobranej liście)</option><% } %>
            </select>
            <% } else { %><input id="<%= prefiks %>-wieksze" name="cennikWiekszych" type="text" autocomplete="off" value="<%= wieksze %>"<% if (wymaganeWieksze) { %> required<% } %><%- aria('cennikWiekszych', true) %>><% } %></span>
            <% if (blad('cennikWiekszych')) { %><span id="<%= prefiks %>-cennikWiekszych-blad" class="ust-cenniki-blad"><%= blad('cennikWiekszych') %></span><% } %></td>
        </tr>
      </tbody>
    </table>
  </div>
</fieldset>
