<p class="wroc"><a href="/magazyn/powiazania">← Powiązania</a></p>
<%- include('../../../core/web/widoki/_naglowek-ekranu.ejs', {tytul: 'Przejęcie ofert ERLI', podtytul: konto}) %>
<section class="panel">
  <div class="panel-glowa"><h2 id="propozycje-erli">Propozycje powiązań</h2></div>
  <div class="panel-cialo">
    <p>Przejęcie zapisuje powiązanie w OMS. Oferta pozostaje obserwowana. Odczyt jest ważny 30 minut.</p>
    <% if (limit) { %><p class="pasek-uwaga">Osiągnięto limit 20 stron odczytu. Lista jest częściowa. Po przejęciu pobierz oferty ponownie.</p><% } %>
    <% if (wynik) { %><p role="status">Przejęto: <%= wynik.przejeto %>. Pominięto: <%= wynik.pominieto %> (brak propozycji, nieaktualna decyzja lub oferta już przejęta).</p><% } %>
    <form method="post" action="/magazyn/powiazania/erli/zatwierdz" aria-label="Przejęcie zaznaczonych ofert">
      <input type="hidden" name="konto" value="<%= konto %>">
      <div class="przewijak-tabeli" tabindex="0" role="region" aria-labelledby="propozycje-erli">
        <table class="tab-pozycje">
          <thead><tr><th scope="col">Wybór</th><th scope="col">Oferta ERLI</th><th scope="col">Karta</th><th scope="col">Powód</th></tr></thead>
          <tbody><% wiersze.forEach(w => { %><tr>
            <td class="kol-zazn"><% if (w.karta && ['active', 'inactive'].includes(w.produkt.status)) { %><label class="kol-zazn-etykieta"><input type="checkbox" name="zaznaczone" value="<%= w.produkt.externalId %>" aria-label="Przejmij ofertę <%= w.produkt.externalId %>"></label><% } %></td>
            <th scope="row"><%= w.produkt.externalId %> · <%= w.produkt.name ?? '' %></th>
            <td><% if (w.karta) { %><a href="/magazyn/<%= w.karta.id %>"><%= w.karta.sku %> · <%= w.karta.nazwa %></a><% } else { %>Brak propozycji<% } %></td>
            <td><%= w.powod %><% if (!['active', 'inactive'].includes(w.produkt.status)) { %> · Brak rozpoznanego stanu oferty<% } %></td>
          </tr><% }); %></tbody>
        </table>
      </div>
      <% if (wiersze.length) { %><button class="btn btn--glowny" type="submit">Przejmij zaznaczone</button><% } else { %><p>Brak ofert do przejęcia.</p><% } %>
    </form>
  </div>
</section>
