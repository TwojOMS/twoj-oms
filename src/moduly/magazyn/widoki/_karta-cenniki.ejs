<%# Cennik dostaw karty: jeden cennik OMS dla całej karty (puste = dobór po rozmiarze). Działa na kontach, z którymi
    cennik ma powiązanie (Magazyn → Cenniki); tabela pod polem pokazuje, co karta dostaje teraz na każdym bieżącym
    koncie Allegro i ERLI — ten sam dobór co podgląd „Wystaw na…”. Bez JS: jeden formularz, jedno „Zapisz”. %>
<% const ck = typeof cennikiKarty !== 'undefined' ? cennikiKarty : null; %>
<% if (ck && ck.konta.length) { %>
<% const NAPIS_CENNIKA = 'Wybrany cennik OMS działa na wszystkich kontach, z którymi ma powiązanie; na pozostałych karta dostaje cennik według rozmiaru. Zmiana dotyczy też już wystawionej oferty.'; %>
<section class="panel" id="cenniki-karty" aria-labelledby="cenniki-tytul">
  <div class="panel-glowa"><h2 id="cenniki-tytul">Cennik dostaw</h2></div>
  <div class="panel-cialo">
    <% if (mozeEdytowacOferty) { %>
      <form method="post" action="/magazyn/<%= karta.id %>/cenniki" aria-labelledby="cenniki-tytul">
        <div class="pola">
          <div>
            <label for="cennik-oms-karty">Cennik dostaw tej karty</label>
            <select id="cennik-oms-karty" name="cennik_oms" aria-describedby="cennik-oms-karty-napis">
              <option value=""<%= ck.wybor === '' ? ' selected' : '' %>>— według rozmiaru —</option>
              <% ck.opcje.forEach(o => { %><option value="<%= o.id %>"<%= o.id === ck.wybor ? ' selected' : '' %>><%= o.etykieta %></option><% }); %>
            </select>
            <p class="podpowiedz" id="cennik-oms-karty-napis"><%= NAPIS_CENNIKA %></p>
          </div>
        </div>
        <div class="przyciski"><button class="btn btn--glowny" type="submit">Zapisz cennik dostaw</button></div>
      </form>
    <% } else { %>
      <p>Cennik dostaw tej karty: <%= ck.nazwaWyboru || 'według rozmiaru' %></p>
      <p class="podpowiedz"><%= NAPIS_CENNIKA %></p>
    <% } %>
    <div class="przewijak-tabeli">
      <table class="tab-pozycje">
        <caption>Cennik w ofercie na każdym koncie</caption>
        <tbody>
          <% ck.konta.forEach(w => { %><tr><th scope="row"><%= w.etykieta %></th><td><% if (w.teraz) { %>Teraz: <%= w.teraz.nazwa %> — <%= w.teraz.powod %><% if (w.teraz.odmowa) { %> <span class="magazyn-brak">Odmowa: <%= w.teraz.odmowa %></span><% } %><% } else { %><span class="magazyn-brak">Odmowa: <%= w.odmowa %></span><% } %></td></tr><% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<% } %>
