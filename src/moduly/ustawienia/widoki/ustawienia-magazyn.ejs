<%- include('../../../core/web/widoki/_naglowek-ekranu.ejs', {tytul: "Stany magazynowe"}) %>

<% if (zapisano) { %><div class="pas-potwierdzenie"><p><%= zapisano %></p></div><% } %>

<section class="ust-sekcja" id="ust-stany">
  <h2 id="ust-stany-tytul">Stany magazynowe</h2>
  <% if (przelacznik.wlaczone) { %>
    <p><strong>Włączone</strong> od: <strong><%= fmtDataCzas(przelacznik.granica) %></strong>.</p>
  <% } else { %>
    <p><strong>Wyłączone.</strong> OMS nie liczy stanów — zakładka Magazyn i karty zamówień wyglądają tak jak dotąd.</p>
  <% } %>
  <p>Po włączeniu OMS liczy stan każdej karty produktu: stan otwarcia i przyjęcia minus sztuki z zamówień złożonych od chwili włączenia. Anulowane zamówienia się nie liczą.</p>
  <ul>
    <li>Brak na stanie nie blokuje zamówienia — zamówienie wchodzi normalnie, a na jego karcie pojawia się ostrzeżenie.</li>
    <% if (przelacznik.wlaczone) { %>
      <li>Ilości będą wysyłane do objętych ofert dopiero po zatwierdzeniu podglądu. Do tego czasu ceny i treść synchronizują się jak dotąd.</li>
    <% } else { %>
      <li>Stany nie są wysyłane do sklepów ani na Allegro. Liczy je tylko OMS.</li>
    <% } %>
    <li>Zamówienia złożone przed włączeniem nie zdejmują towaru.</li>
  </ul>
  <% if (przelacznik.wlaczone) { %>
    <p><a href="/magazyn/stany/otwarcie">Stan otwarcia z kanałów</a> · <a href="/magazyn/stany/kanaly/podglad">Podgląd stanów w kanałach</a></p>
  <% } %>
  <form id="ust-stany-przelacz" method="post" action="/ustawienia/magazyn/stany" aria-labelledby="ust-stany-tytul">
    <% if (przelacznik.wlaczone) { %>
      <input type="hidden" name="wlacz" value="0">
      <p class="pas-uprzedzenie">Wyłączenie niczego nie kasuje. Ponowne włączenie liczy od nowa — od nowej granicy. Stan otwarcia można wpisać albo kontynuować od stanu z wyłączenia, pomniejszonego o zamówienia z przerwy.</p>
      <% if (liczniki.zarzadzane + liczniki.przejete > 0) { %>
        <p id="skutki-wylaczenia"><%= liczniki.zarzadzane %> ofert wróci do stałej ilości, <%= liczniki.przejete %> przejętych przestanie być synchronizowanych.</p>
        <p><input type="checkbox" id="rozumiem" name="rozumiem" value="1" required aria-describedby="skutki-wylaczenia"> <label for="rozumiem">Rozumiem (wymagane)</label></p>
      <% } %>
      <div class="ust-akcje"><button class="btn" type="submit">Wyłącz stany magazynowe</button></div>
    <% } else { %>
      <input type="hidden" name="wlacz" value="1">
      <% if (bylWlaczony) { %>
        <p class="pas-uprzedzenie">Stany były już włączone. Ponowne włączenie liczy od nowa: od teraz. Możesz kontynuować od stanu z wyłączenia, pomniejszonego o zamówienia z przerwy. Wcześniejsze wpisy zostają w bazie.</p>
      <% } %>
      <div class="ust-akcje"><button class="btn btn--glowny" type="submit">Włącz stany magazynowe</button></div>
    <% } %>
  </form>

  <% if (przelacznik.historia.length) { %>
    <h3>Historia przełączania</h3>
    <table class="tab-pozycje" id="ust-stany-historia">
      <thead><tr><th>Kiedy</th><th>Kto</th><th>Zmiana</th></tr></thead>
      <tbody>
        <% przelacznik.historia.forEach(function (w) { %>
          <tr>
            <td><%= fmtDataCzas(w.utworzono_at) %></td>
            <td><%= w.konto_login ?? '—' %></td>
            <td><%= w.wlaczone ? 'włączenie' : 'wyłączenie' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</section>

<section class="ust-sekcja" id="ust-zrodla">
  <h2 id="ust-zrodla-tytul">Kolejność źródeł treści karty</h2>
  <form method="post" action="/ustawienia/magazyn/zrodla" aria-labelledby="ust-zrodla-tytul" aria-describedby="ust-zrodla-pomoc">
    <ol>
      <% zrodla.forEach(function (z, i) { %>
        <li>
          <input type="hidden" name="kolejnosc" value="<%= z.klucz %>">
          <span><%= z.nazwa %> (<%= z.klucz %>)</span>
          <button class="btn" type="submit" name="przesun" value="wyzej:<%= z.klucz %>" aria-label="Wyżej: <%= z.nazwa %> (<%= z.klucz %>)" <%= i === 0 ? 'disabled' : '' %>>Wyżej</button>
          <button class="btn" type="submit" name="przesun" value="nizej:<%= z.klucz %>" aria-label="Niżej: <%= z.nazwa %> (<%= z.klucz %>)" <%= i === zrodla.length - 1 ? 'disabled' : '' %>>Niżej</button>
        </li>
      <% }); %>
    </ol>
    <% if (!zrodla.length) { %><p>Brak skonfigurowanych sklepów Woo i kont Allegro.</p><% } %>
  </form>
  <p id="ust-zrodla-pomoc">Przy pustym polu karty wygrywa źródło wyżej. Pola poprawione ręcznie nie są nadpisywane.</p>
  <% if (zrodla.length) { %><p>Przyciski „Wyżej” i „Niżej” zapisują kolejność.</p><% } %>
</section>
