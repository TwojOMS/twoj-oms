<%- include('../../../core/web/widoki/_naglowek-ekranu.ejs', {tytul: (title)}) %>
<% if (tylkoReklamy) { %><p><a href="/ustawienia/integracje">← Moje połączenia</a></p><% } %>

<% if (zapisano) { %><div class="pas-potwierdzenie"><p><%= zapisano %></p></div><% } %>
<% if (testOdczytu) { %><div class="<%= testOdczytu.ok ? 'pas-potwierdzenie' : 'pas-uprzedzenie' %>" id="reklamy-test"><p><%= testOdczytu.tekst %></p></div><% } %>
<% if (blad) { %><div class="pas-uprzedzenie"><p><strong>Nie udało się rozpocząć wiązania.</strong> <%= blad %></p></div><% } %>

<% if (tylkoReklamy) { %>
<p>Każde źródło działa niezależnie. Brak połączenia nie zatrzymuje zamówień ani wysyłki.</p>
<% zrodlaReklam.forEach((zrodlo) => { %>
<section class="ust-sekcja" id="reklamy-<%= zrodlo.typ %>">
  <h2><%= zrodlo.etykieta %></h2>
  <% if (!zrodlo.stan.length) { %>
    <p class="ust-stan"><strong>Niepodłączone</strong></p>
    <p><%= zrodlo.typ === 'google_ads' ? 'Opcjonalny odczyt statusów i budżetów wymaga dostępu do Google Ads API.' : 'Podłącz własne konto, aby zobaczyć jego dzienne statystyki reklam.' %></p>
  <% } else { %>
    <% zrodlo.stan.forEach((polaczenie) => { %>
      <% const wynik = polaczenie.stan?.kodBledu ? 'Błąd' : polaczenie.stan?.ostatniSukcesAt ? 'Działa' : 'Weryfikacja'; %>
      <div class="ust-kanal">
        <p class="ust-stan <%= wynik === 'Działa' ? 'ust-stan-ok' : wynik === 'Błąd' ? 'ust-stan-blad' : 'ust-stan-weryfikacja' %>"><strong><%= wynik %></strong></p>
        <p>Konto <%= polaczenie.kontoId %>, kanał <%= polaczenie.kanal ?? 'nieprzypisany' %>.</p>
        <% if (polaczenie.stan?.ostatniSukcesAt) { %><p>Ostatni udany odczyt: <%= fmtKiedy(polaczenie.stan.ostatniSukcesAt) %></p><% } %>
        <% if (polaczenie.stan?.kodBledu) { %><p>Kod błędu: <%= polaczenie.stan.kodBledu %></p><% } %>
        <% if (mozeKonfigurowacReklamy) { %>
          <form method="post" action="/ustawienia/integracje/reklamy/test">
            <input type="hidden" name="polaczenieId" value="<%= polaczenie.id %>">
            <div class="ust-akcje"><button class="btn" type="submit">Test odczytu</button></div>
          </form>
        <% } %>
      </div>
    <% }); %>
  <% } %>
</section>
<% if (!zrodlo.stan.length) { %>
<aside class="ust-instrukcja" id="reklamy-<%= zrodlo.typ %>-instrukcja">
  <h3>Co jest potrzebne i jak to podłączyć</h3>
  <p>Potrzebne: konto źródła, kanał OMS i poświadczenie tylko do odczytu zapisane w sekretach serwera.</p>
  <textarea id="prompt-<%= zrodlo.typ %>" class="ust-prompt" readonly rows="<%= Math.min(40, Math.max(7, String(zrodlo.prompt || '').split('\n').reduce((n, l) => n + Math.max(1, Math.ceil(l.length / 80)), 0) + 1)) %>"><%= zrodlo.prompt %></textarea>
  <div class="ust-akcje">
    <button class="btn" type="button" onclick="this.parentElement.previousElementSibling.select(); document.execCommand('copy')">Skopiuj prompt dla agenta</button>
  </div>
</aside>
<% } %>
<% }); %>
<% if (mozeKonfigurowacReklamy && formularzSekretu) { %>
<section class="ust-sekcja" id="reklamy-dodaj">
  <h2>Dodaj połączenie</h2>
  <form id="reklamy-formularz" class="ust-formularz" method="post" action="/ustawienia/integracje/reklamy/zapisz">
    <label for="reklamy-typ">Źródło <span class="ust-wymagane">*</span></label>
    <div><select id="reklamy-typ" name="typ" required><option value="ga4"><%= zrodlaReklam.find((z) => z.typ === 'ga4')?.etykieta %></option><option value="meta"><%= zrodlaReklam.find((z) => z.typ === 'meta')?.etykieta %></option></select>
      <p class="ust-pomoc">Każde źródło podłączasz osobno.</p></div>

    <label for="reklamy-konto">ID konta lub właściwości <span class="ust-wymagane">*</span></label>
    <div><input id="reklamy-konto" name="kontoId" autocomplete="off" required>
      <p class="ust-pomoc">Identyfikator właściwości GA4 albo konta reklamowego Meta.</p></div>

    <label for="reklamy-kanal">Kanał OMS <span class="ust-wymagane">*</span></label>
    <div><input id="reklamy-kanal" name="kanal" autocomplete="off" required>
      <p class="ust-pomoc">Kanał, do którego przypisane są statystyki tego konta.</p></div>

    <label for="reklamy-tresc">Poświadczenie <span class="ust-wymagane">*</span></label>
    <div><textarea id="reklamy-tresc" name="tresc" rows="5" autocomplete="off" required></textarea>
      <p class="ust-pomoc">Klucz lub token tylko do odczytu. Trafia do magazynu sekretów serwera, nie do bazy zamówień, i nie jest później pokazywany.</p></div>

    <p class="ust-pelna ust-pomoc">Pola oznaczone <span class="ust-wymagane">*</span> są wymagane.</p>
    <div class="ust-pelna ust-akcje">
      <button class="btn btn--glowny" type="submit">Zapisz połączenie</button>
    </div>
  </form>
</section>
<% } else if (mozeKonfigurowacReklamy) { %>
<section class="ust-sekcja" id="reklamy-dodaj">
  <h2>Dodaj połączenie</h2>
  <p>Poświadczenie zapisz bezpośrednio w sekretach serwera. Formularz jest dostępny tylko przez zaufane HTTPS z podłączonym magazynem sekretów.</p>
</section>
<% } %>
<% } else { %>
<div class="ust-sekcja">
  <h2>Poczta</h2>
  <p><a href="/ustawienia/integracje/poczta">Poczta wychodząca (SMTP)</a> — serwer, login i hasło skrzynki, adres OMS-u do linków w mailach, wiadomość próbna.</p>
</div>
<div class="ust-sekcja">
  <h2>Faktury</h2>
  <p><a href="/ustawienia/integracje/program-fakturowy">Moduł faktur</a> — czy OMS wystawia faktury i w którym programie: <%= zgodaTf ? 'Brak, inFakt albo TwojeFaktury' : 'Brak albo inFakt' %>.</p>
  <% if (zgodaTf) { %><p><a href="/ustawienia/integracje/program-fakturowy/ksef">Wysyłka do KSeF</a> — wysyłka faktur sprzedaży z TwojeFaktury.</p><% } %>
  <p><a href="/ustawienia/integracje/infakt">inFakt</a> — klucz API do wystawiania faktur sprzedaży, sprawdzenie połączenia.</p>
  <p><a href="/ustawienia/integracje/ksef">KSeF — faktury kosztowe</a> — <% if (wbudowany) { %><%= String(zdanieTokenKosztow).replace(/\.$/, "") %> — <a href="/ustawienia/integracje/program-fakturowy/ksef">Wysyłka do KSeF</a>.<% } else { %>token tylko do przeglądania faktur zakupowych: nocne pobieranie kosztów, sprawdzenie połączenia. OMS niczego przez KSeF nie wysyła.<% } %></p>
</div>
<div class="ust-sekcja">
  <h2>Dane firm</h2>
  <p><a href="/ustawienia/integracje/gus">GUS (dane firm po NIP)</a> — klucz do bazy REGON: przycisk „Pobierz z GUS” wpisuje nazwę i adres firmy po NIP-ie, sprawdzenie połączenia.</p>
</div>
<div class="ust-sekcja">
  <h2>Reklamy</h2>
  <p><a href="/ustawienia/integracje/reklamy">Meta Ads, Google Analytics 4 i Google Ads</a> — dostęp tylko do odczytu, dzienne statystyki kampanii, test odczytu połączenia.</p>
</div>
<div class="ust-sekcja">
  <h2>Kanały Allegro</h2>
  <% if (mozeKonfigurowacReklamy) { %><p><a href="/ustawienia/integracje/allegro/nowe">Podłącz konto i zarządzaj połączeniami Allegro</a></p><% } %>
  <% if (!kanaly.length) { %>
    <p class="pusto-sekcja">Ten OMS nie ma skonfigurowanych kanałów Allegro.</p>
  <% } %>
  <% kanaly.forEach((kanal) => { %>
    <div class="ust-kanal">
      <p>
        <strong><%= kanal.stan.kanal %></strong> —
        <% if (kanal.stan.pilne) { %><span class="uwaga">nie działa</span>
        <% } else if (kanal.stan.uprzedzenie) { %>wkrótce przestanie działać
        <% } else { %>działa<%= kanal.stan.zostaloDni != null ? ` (połączenie ważne jeszcze ${kanal.stan.zostaloDni} dni)` : '' %><% } %>
      </p>
      <p>Konto Allegro: <strong><%= kanal.stan.kontoAllegro ?? 'nieznane' %></strong></p>
      <% if (mozeKonfigurowacReklamy) { %><p><a href="/ustawienia/integracje/allegro/<%= encodeURIComponent(kanal.stan.kanal) %>">Konfiguruj połączenie</a></p><% } %>
      <% if (kanal.stan.powod) { %><p><%= kanal.stan.powod %></p><% } %>
      <% if (kanal.wiazanie) { %>
        <div class="pas-uprzedzenie">
          <p><strong>Wiązanie w toku.</strong> Otwórz link, zaloguj się na właściwe konto Allegro i przepisz kod.</p>
          <p><a href="<%= kanal.wiazanie.adres %>" target="_blank" rel="noopener noreferrer"><%= kanal.wiazanie.adres %></a></p>
          <p>Kod: <strong style="font-size:1.3rem;letter-spacing:.1em"><%= kanal.wiazanie.userCode %></strong></p>
          <% if (kanal.wiazanie.blad) { %><p class="uwaga"><%= kanal.wiazanie.blad %></p><% } %>
        </div>
      <% } else if (kanal.stan.wolnoWiazac) { %>
        <form method="post" action="/ustawienia/kanaly/<%= kanal.stan.kanal %>/wiazanie">
          <button class="btn btn--glowny" type="submit">Połącz z Allegro</button>
        </form>
      <% } %>
    </div>
  <% }); %>
</div>
<% } %>
