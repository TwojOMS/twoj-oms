<%#
  Konta i uprawnienia. Ten ekran jest pierwszym miejscem (także dla kogoś, kto wdraża ten kod
  u siebie), w którym zakłada się konta; bez niego byłoby to możliwe tylko zapytaniem SQL.
  Pierwsze konto powstaje przy pustej tabeli, gdy na ekran wchodzi konto serwisowe z `.env`
  (tests/moduly/ustawienia/web-konta.test.js, „konto serwisowe na pustej tabeli").

  ⚠️ UKŁAD WSPÓLNY Z podstronami Ustawień (`ust-sekcja`/`ust-pola`/`ust-akcje`/`btn`) —
  ta sama paleta, jasna i ciemna, zero nowych kolorów wpisanych z palca.

  ⚠️ FORMULARZE NIE NOSZĄ TOKENU CSRF. Ochrona sprawdza źródło żądania (nagłówek Origin, a gdy
  go brak — Referer; core/bezpieczenstwo/csrf.js), nie token w formularzu — jeden mechanizm dla
  WSZYSTKICH tras, także tych dopisanych później, więc ten ekran nie dokłada niczego własnego.

  ⚠️ FORMULARZ „NOWE KONTO" NIE MA PTASZKÓW EKRANÓW: `POST /ustawienia/konta/nowe`
  (moduly/ustawienia/trasy/konta.js) czyta `login`/`imie`/`email`/`rola`/`sposob` (przy braku `sposob`
  także `haslo`, dla testów i skryptów); konto dostaje ekrany wybranej roli zapisane w bazie. Ptaszek tutaj, którego
  trasa i tak by zignorowała, wyglądałby jak działające pole — uprawnienia poprawia się PO założeniu, w sekcji konta poniżej.
%>
<% const tylkoLogowania = nawigacja?.kontekst?.aktywnaZakladka === 'logowania'; %>
<% if (!tylkoLogowania) { %>
<%- include('../../../core/web/widoki/_naglowek-ekranu.ejs', {tytul: "Użytkownicy i uprawnienia"}) %>

<% if (zapisano) { %>
  <div class="pas-potwierdzenie"><p><%= zapisano %></p></div>
<% } %>

<% if (blad) { %>
  <div class="pas-uprzedzenie"><p><strong>Nie udało się zapisać.</strong> <%= blad %></p></div>
<% } %>

<div class="ust-sekcja">
  <h2>Wylogowanie wszystkich sesji</h2>
  <p>
    Ta operacja wyloguje <strong>wszystkie osoby na wszystkich urządzeniach</strong>, także Ciebie.
    Każdy będzie musiał zalogować się ponownie.
    <% if (sekretZmieniony) { %> Ostatnia globalna rotacja: <strong><%= fmtDataCzas(sekretZmieniony) %></strong>.<% } %>
  </p>
  <form method="post" action="/ustawienia/konta/wyloguj-wszystkie"
    onsubmit="return confirm('Wylogować wszystkie osoby na wszystkich urządzeniach?')">
    <div class="ust-akcje"><button class="btn" type="submit">Wyloguj wszystkie osoby</button></div>
  </form>
</div>

<div class="ust-sekcja">
  <h2>Konta w panelu <span style="font-weight:normal;color:var(--tekst-przygaszony)">(<%= konta.length %>)</span></h2>
  <% if (!konta.length) { %>
    <p>Baza jest pusta — załóż pierwsze konto poniżej. Warto zacząć od roli Administrator,
      żeby od razu przejąć panel z konta serwisowego z <code>.env</code>.</p>
  <% } else { %>
    <div class="przewijak-tabeli" tabindex="0" role="region" aria-label="Lista kont">
    <table class="tab-pozycje">
      <thead>
        <tr><th>Imię</th><th>Login</th><th>Rola</th><th>Czynne</th><th>Ostatnie logowanie</th></tr>
      </thead>
      <tbody>
        <% konta.forEach(function (k) { %>
          <tr>
            <td><a href="#konto-<%= k.id %>"><%= k.imie %></a><% if (k.id === wlasneId) { %> <span class="wyjasnienie">(Ty)</span><% } %></td>
            <td><%= k.login %></td>
            <td><%= k.opisRoli %></td>
            <td><%= k.czynne ? 'Tak' : 'Nie' %></td>
            <td><%= k.ostatnie_logowanie ? fmtDataCzas(k.ostatnie_logowanie) : '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<div class="ust-sekcja">
  <h2>Nowe konto</h2>
  <form method="post" action="/ustawienia/konta/nowe">
    <div class="ust-pola">
      <label>Imię <input name="imie" required placeholder="np. Anna" value="<%= noweKonto.imie %>"></label>
      <label>Login <input name="login" required placeholder="np. anna" value="<%= noweKonto.login %>"></label>
      <label>E-mail <input type="email" name="email" placeholder="np. anna@firma.pl" value="<%= noweKonto.email %>"></label>
      <label>Rola
        <select name="rola" required class="oms-pole">
          <% if (noweKonto.rola && !role.some(function (r) { return r.klucz === noweKonto.rola; })) { %>
            <option value="<%= noweKonto.rola %>" selected disabled>Nieznana rola: <%= noweKonto.rola %></option>
          <% } %>
          <% role.forEach(function (r) { %><option value="<%= r.klucz %>" <%= r.klucz === noweKonto.rola ? 'selected' : '' %>><%= r.etykieta %></option><% }); %>
        </select>
      </label>
    </div>
    <%# Konto powstaje BEZ hasła — pracownik ustawia je sam z jednorazowego linku (48 h). %>
    <div class="ust-pola" style="flex-direction:column;align-items:flex-start">
      <label class="pole-przelacznik"><input type="radio" name="sposob" value="pokaz" checked> Pokaż link do skopiowania</label>
      <label class="pole-przelacznik"><input type="radio" name="sposob" value="mail"> Wyślij zaproszenie mailem (wymaga e-maila i ustawionej poczty — <a href="/ustawienia/integracje/poczta">Ustawienia → Integracje → Poczta wychodząca</a>; bez wpisanego tam adresu panelu link prowadzi pod adres, z którego teraz korzystasz)</label>
    </div>
    <div class="ust-akcje"><button class="btn btn--glowny" type="submit">Dodaj użytkownika</button></div>
  </form>
</div>

<%# ——— PER KONTO: uprawnienia, haslo, przelacznik czynne ——————————————————————————————— %>
<% konta.forEach(function (k) { %>
  <%
    // Dwa NIEZALEŻNE powody, dla których ten formularz ma zablokowaną możliwość odebrania
    // admina/wyłączenia — patrz komentarze przy bezpiecznikach w moduly/ustawienia/trasy/konta.js:
    //   1) TO KONTO, na którym akurat jesteśmy zalogowani (nie zamykaj się sam),
    //   2) TO JEDYNY czynny administrator w całym panelu (brama degradacji zamknęłaby się
    //      na zawias — hasło z .env znowu stałoby się pełnym adminem).
    const toJa = k.id === wlasneId;
    const zablokowany = toJa || k.ostatniAdmin;
  %>
  <div class="ust-sekcja" id="konto-<%= k.id %>">
    <h2><%= k.imie %> <span style="font-weight:normal;color:var(--tekst-przygaszony)">(<%= k.login %>)</span><% if (toJa) { %> <span class="wyjasnienie">— to Ty</span><% } %></h2>
    <p>
      Rola: <strong><%= k.opisRoli %></strong> ·
      <%= k.czynne ? 'czynne' : 'wyłączone' %>
      <% if (k.zaproszone) { %> · <strong>zaproszone</strong> (hasło jeszcze nieustawione)<% } %>
      <% if (k.ostatnie_logowanie) { %> · ostatnie udane logowanie: <%= fmtDataCzas(k.ostatnie_logowanie) %><% } %>
    </p>
    <% if (zablokowany) { %>
      <p class="wyjasnienie">
        <% if (toJa) { %>Nie możesz odebrać uprawnień administratora ani wyłączyć własnego konta z tego ekranu.<% } %>
        <% if (k.ostatniAdmin && !toJa) { %>To jedyny czynny administrator panelu — nie można mu odebrać uprawnień administratora ani go wyłączyć, dopóki nie ma innego czynnego admina.<% } %>
      </p>
    <% } %>

    <%# Dostęp konta wynika z ROLI (ptaszki ról: Ustawienia → Role i uprawnienia). %>
    <form method="post" action="/ustawienia/konta/<%= k.id %>/rola">
      <div class="ust-pola">
        <label>Rola
          <select name="rola" required class="oms-pole">
            <% if (!role.some(function (r) { return r.klucz === k.rola; })) { %>
              <option value="<%= k.rola %>" selected disabled>Nieznana rola: <%= k.rola %></option>
            <% } %>
            <% role.forEach(function (r) { %><option value="<%= r.klucz %>" <%= r.klucz === k.rola ? 'selected' : '' %>><%= r.etykieta %></option><% }); %>
          </select>
        </label>
      </div>
      <div class="ust-akcje"><button class="btn btn--glowny" type="submit">Zmień rolę</button></div>
    </form>

    <%# Formularz ptaszków per konto wraca WYŁĄCZNIE w odpowiedzi 400 trasy POST /ustawienia/konta/:id/uprawnienia %>
    <%# — żeby odmowa pokazała, co operator wybrał. Zapis i tak idzie przez rolę osobistą. %>
    <% if (k.edycja) { %>
    <form method="post" action="/ustawienia/konta/<%= k.id %>/uprawnienia">
      <div class="ust-pola" style="flex-direction:column;align-items:flex-start">
        <% EKRANY.forEach(function (e) { %>
          <label class="pole-przelacznik">
            <input type="checkbox" name="ekran" value="<%= e.klucz %>" <%= k.ekrany.has(e.klucz) ? 'checked' : '' %>>
            <%= e.etykieta %>
          </label>
        <% }); %>
        <%# ⚠️ `api` NIE JEST W `EKRANY` — to klucz oddzielny: dostęp maszynowy do adresów /api/* %>
        <%# dla zewnętrznej aplikacji, patrz ekranDlaAdresu w domena/ekrany.js i filtr w moduly/ustawienia/trasy/konta.js. %>
        <label class="pole-przelacznik">
          <input type="checkbox" name="ekran" value="api" <%= k.ekrany.has('api') ? 'checked' : '' %>>
          Dostęp przez API (zewnętrzna aplikacja)
        </label>
      </div>
      <label class="pole-przelacznik">
        <% if (zablokowany) { %>
          <%# ⚠️ CELOWO BEZ `disabled`: pole WYŁĄCZONE nie wysyłałoby WCALE wartości `admin`, %>
          <%# co serwer odczytałby jako próbę zdjęcia admina — dokładnie to, co blokujemy. %>
          <%# Ukryte pole gwarantuje `admin=1` niezależnie od tego, co operator kliknie tutaj. %>
          <input type="checkbox" checked onclick="return false" aria-disabled="true">
          <input type="hidden" name="admin" value="1">
        <% } else { %>
          <input type="checkbox" name="admin" value="1" <%= k.admin ? 'checked' : '' %>>
        <% } %>
        Administrator — pełny dostęp, zakłada i zmienia konta
      </label>
      <div class="ust-akcje"><button class="btn btn--glowny" type="submit">Zapisz uprawnienia</button></div>
    </form>
    <% } %>

    <%# Admin nie wpisuje cudzego hasła — wysyła link do jego ustawienia ze strony konta. %>
    <p><a href="/ustawienia/konta/<%= k.id %>">Szczegóły i link do hasła</a></p>

    <% if (!zablokowany) { %>
      <form method="post" action="/ustawienia/konta/<%= k.id %>/czynne">
        <input type="hidden" name="czynne" value="<%= k.czynne ? '0' : '1' %>">
        <div class="ust-akcje">
          <button class="btn" type="submit">
            <%= k.czynne ? 'Wyłącz konto' : 'Włącz konto' %>
          </button>
        </div>
      </form>
    <% } %>
  </div>
<% }); %>

<% } %>
<% if (tylkoLogowania) { %>
<%- include('../../../core/web/widoki/_naglowek-ekranu.ejs', {tytul: "Historia logowań"}) %>
<%# ——— DZIENNIK LOGOWAŃ — zakładka „Historia logowań” (/ustawienia/zespol/logowania): administrator, który podejrzewa %>
<%# włamanie, ma zobaczyć, kto próbował wejść, obok zakładki z listą kont, czyli tych, którzy mają dostęp. %>
<div class="ust-sekcja">
  <h2>Ostatnie logowania</h2>
  <% if (!logowania.length) { %>
    <p>Jeszcze nikt się nie logował.</p>
  <% } else { %>
    <div class="przewijak-tabeli" tabindex="0" role="region" aria-label="Historia logowań">
    <table class="tab-pozycje">
      <%# Kolumna IP — ostatnieLogowania() (core/bezpieczenstwo/konta.js) ją pobiera i widok %>
      <%# ją pokazuje. Przy „podejrzewam włamanie" to najważniejsza kolumna na ekranie. %>
      <thead><tr><th>Kiedy</th><th>Login</th><th>IP</th><th>Wynik</th><th>Usługa</th></tr></thead>
      <tbody>
        <% logowania.forEach(function (l) { %>
          <tr>
            <td><%= fmtDataCzas(l.at) %></td>
            <td><%= l.login %></td>
            <td><%= l.ip ?? '—' %></td>
            <%# `l.opisWyniku` (moduly/ustawienia/trasy/konta.js) — tekst dla człowieka, z ogonkami; %>
            <%# surowy identyfikator `l.wynik` zostaje wyłącznie w bazie i w kodzie. %>
            <td><%= l.opisWyniku %></td>
            <td><%= l.usluga %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<% } %>
