<%# PRZ-136.14 (#11): własny <h1> z tytułem zakładki jak w innych działach Ustawień — powłoka daje tylko nagłówek ARIA działu. %>
<h1><%= title %></h1>
<% const kategorie = { sklepy: 'Sklepy i marketplace’y', wysylka: 'Wysyłka', faktury: 'Fakturowanie i dane firm', poczta: 'Poczta', reklamy: 'Reklamy i analityka' }; %>
<% if (blad) { %><div class="pas-uprzedzenie"><%= blad %></div><% } %>
<% if (zapisano) { %><div class="pas-potwierdzenie"><%= zapisano %></div><% } %>
<% if (katalog) { %>
<p>Wybierz usługę. Dane połączenia ustawiasz tutaj, a sposób pracy firmy w odpowiednim dziale Ustawień.</p>
<form method="get" action="/ustawienia/integracje/katalog" class="ust-filtry">
  <label>Szukaj integracji<input type="search" name="szukaj" value="<%= filtry.szukaj %>" placeholder="Nazwa lub opis"></label>
  <label>Kategoria<select name="kategoria"><option value="">Wszystkie kategorie</option><% Object.entries(kategorie).forEach(([id,nazwa]) => { %><option value="<%= id %>"<%= filtry.kategoria === id ? ' selected' : '' %>><%= nazwa %></option><% }); %></select></label>
  <input type="hidden" name="planowane" value="nie"><label class="ust-checkbox"><input type="checkbox" name="planowane" value="tak"<%= filtry.planowane ? ' checked' : '' %>> Pokaż planowane</label>
  <button class="btn" type="submit">Filtruj</button>
</form>
<% Object.entries(kategorie).forEach(([id,nazwa]) => { const wpisy = uslugi.filter(u => u.kategoria === id); if (!wpisy.length) return; %>
<section class="ust-kategoria"><h2><%= nazwa %></h2><div class="ust-katalog">
<% wpisy.forEach(u => { const ile=liczPolaczenia(polaczenia.filter(p=>p.usluga===u.id)); %>
<% const planowana = u.dostepnosc === 'planowana'; const pol = polaczenia.filter(p=>p.usluga===u.id);
   // Jedno konto Allegro otwieramy bezpośrednio; kilka kont wybiera się w grupie.
   const celZarzadzaj = u.id === 'allegro' && pol.length === 1 && pol[0].akcja ? pol[0].akcja.href : u.id === 'woocommerce' && pol.length === 1 && pol[0].id ? '/ustawienia/integracje#pol-' + String(pol[0].id).toLowerCase().replace(/[^a-z0-9_-]+/g, '-') : '/ustawienia/integracje#grupa-sprzedaz'; %>
<article class="ust-karta-integracji<%= planowana ? ' ust-karta-integracji--planowana' : '' %>" data-usluga="<%= u.id %>"><div class="ust-logo-marki"><img src="/public<%= u.logo %>" alt="<%= u.nazwa %>" width="100" height="38"></div>
<h3><%= u.nazwa %></h3><p><%= u.opis %></p>
<% if (planowana) { %><span class="ust-znacznik ust-znacznik--wkrotce">Wkrótce</span>
<% } else { %><span class="ust-znacznik"><%= u.dostepnosc === 'przez_konfiguracje' ? 'Ustawia administrator serwera' : 'Dostępna' %></span>
<% if (ile) { %><p class="ust-pomoc">Połączenia: <%= ile %></p><% } %>
<% if (u.konfigurator) { %><div class="ust-karta-akcje"><a class="btn btn--drugi btn--maly" href="<%= u.konfigurator.href %>"><%= u.konfigurator.dodaj.charAt(0).toUpperCase() + u.konfigurator.dodaj.slice(1) %></a><% if (ile) { %><a class="ust-link" href="<%= celZarzadzaj %>">Zarządzaj</a><% } %></div>
<% } else if (u.href) { %><div class="ust-karta-akcje"><% if (ile) { %><a class="ust-link" href="<%= u.href %>">Zarządzaj</a><% } else { %><a class="btn btn--drugi btn--maly" href="<%= u.href %>"><%= u.dostepnosc === 'przez_konfiguracje' ? 'Jak podłączyć' : 'Konfiguruj' %></a><% } %></div><% } %>
<% } %>
</article><% }); %></div></section><% }); %>
<% if (!uslugi.length) { %><p class="ust-sekcja">Brak usług pasujących do filtrów.</p><% } %>
<% } else if (!polaczenia.length) { %>
<%- include('ustawienia-polaczenia-pusto', { wszystkieUslugi }) %>
<% } else {
  // PRZ-136.07: lista w grupach (U1–U4, U10–U11). Jedyny <h1> jest na początku widoku.
  const odmiana = (n, [jeden, kilka, wiele]) => n === 1 ? jeden : (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? kilka : wiele;
  const idWiersza = (p) => 'pol-' + String(p.id).toLowerCase().replace(/[^a-z0-9_-]+/g, '-');
  const pierwszy = (f) => { const p = polaczenia.find(f); return p ? '#' + idWiersza(p) : null; };
  const ile = { ...podsumowanie, blad: podsumowanie.blad ?? 0,
    przyklad: liczPolaczenia(polaczenia.filter(p => p.stan === 'niesprawdzone' && p.atrapa)), niesprawdzone: liczPolaczenia(polaczenia.filter(p => p.stan === 'niesprawdzone' && !p.atrapa)) };
  const liczniki = [
    ['blad', ile.blad, odmiana(ile.blad, ['błąd', 'błędy', 'błędów']), pierwszy(p => p.stan === 'blad')],
    ['uwaga', ile.uwaga, odmiana(ile.uwaga, ['wymaga uwagi', 'wymagają uwagi', 'wymaga uwagi']), pierwszy(p => p.stan === 'uwaga')],
    ['dziala', ile.dziala, 'działa', pierwszy(p => p.stan === 'dziala')],
    ['', ile.niesprawdzone, 'niesprawdzone', pierwszy(p => p.stan === 'niesprawdzone' && !p.atrapa)],
    ['', ile.przyklad, 'na danych przykładowych', pierwszy(p => p.stan === 'niesprawdzone' && p.atrapa)],
    ['wstrzymane', ile.wstrzymane, 'wstrzymane', '#pol-wstrzymane'],
  ].filter(([, n]) => n > 0);
  const grupy = { sprzedaz: 'Sprzedaż', wysylka: 'Wysyłka', faktury: 'Faktury i KSeF', poczta: 'Poczta i analityka' };
  const wGrupie = (g) => polaczenia.filter(p => p.stan !== 'wylaczone' && p.grupa !== 'wstrzymane' && (grupy[p.grupa] ? p.grupa : 'poczta') === g);
  const wstrzymane = polaczenia.filter(p => p.stan === 'wylaczone' || p.grupa === 'wstrzymane'); %>
<div class="pol-podsumowanie">
<p class="pol-podsumowanie-liczby" aria-label="Podsumowanie połączeń"><span class="pol-licznik"><strong><%= ile.razem %></strong> <%= odmiana(ile.razem, ['połączenie', 'połączenia', 'połączeń']) %></span>
<% liczniki.forEach(([klasa, n, tekst, cel]) => { %><a class="pol-licznik<%= klasa ? ' pol-licznik--' + klasa : '' %>" href="<%= cel %>"><span class="pol-kropka" aria-hidden="true"></span><strong><%= n %></strong> <%= tekst %></a>
<% }); %></p>
<a class="btn btn--glowny" href="/ustawienia/integracje/katalog">Dodaj integrację</a>
</div>
<% Object.entries(grupy).forEach(([g, nazwa]) => { const wiersze = wGrupie(g); if (!wiersze.length) return; %>
<section class="pol-grupa" id="grupa-<%= g %>" aria-labelledby="g-<%= g %>">
<h2 id="g-<%= g %>"><%= nazwa %> <span class="pol-grupa-ile"><%= wiersze.length %></span></h2>
<ul class="pol-lista"><% wiersze.forEach(p => { %><%- include('ustawienia-polaczenia-wiersz', { p, idWiersza: idWiersza(p) }) %><% }); %></ul>
</section>
<% }); %>
<% if (wstrzymane.length) { %>
<details class="pol-wstrzymane" id="pol-wstrzymane">
<summary>Wstrzymane <span class="pol-grupa-ile"><%= wstrzymane.length %></span> <span class="pol-wstrzymane-pomoc">OMS ich nie odpytuje; dane zostają</span></summary>
<ul class="pol-lista"><% wstrzymane.forEach(p => { %><%- include('ustawienia-polaczenia-wiersz', { p, idWiersza: idWiersza(p) }) %><% }); %></ul>
</details>
<% } %>
<p class="pol-stopka">Stan każdego konta OMS ocenia osobno: „Działa” znaczy, że ostatni odczyt z hasłem lub tokenem się udał — sam zapisany klucz tego nie potwierdza. Program do faktur wybierasz w <a href="/ustawienia/integracje/program-fakturowy">Faktury i podatki → Program do faktur</a>.</p>
<% } %>
