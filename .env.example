# KANDYDAT PRZ-030, kod 05f827c5669c750f04bc17c4357187445335e29a, przed niezależnym PRZYJĘTE.
# Pełny produkt po integracji ustawień, zdrowia, API panelu i punktu wejścia.
# Baza porównania: 26f3f1e5737b22329e6ab7f4102898837f43de6d.
# api-panelu nie ma własnych env ani zegarów; używa istniejącej proformy.
# main i zbudujOms korzystają ze wspólnej listy modulyDla: 14 modułów.
# Bez sekretów, danych firmy i wartości historycznych fixture.
# Ten plik nie uruchamia samodzielnego demo. NIP/NRB są wymagane także w proba.
# Wartości dostarcza proces lub zewnętrzny loader (np. env_file kontenera).
# Zakomentowane puste pola oznaczają brak ustawienia, a nie działający default.
# Wypełnij wymagane dane własnej instalacji lokalnie, poza repo i manifestem.

# Rdzeń i uruchomienie
# D02: przed PRZ-042 instalacja ustawia jawnie OMS_TRYB=produkcja.
# Przykład pozostaje w proba; każda niepusta wartość poświadczenia, nawet whitespace,
# blokuje próbę także dla odłożonych integracji.
OMS_TRYB=proba
OMS_DB_PATH=/data-oms/oms.sqlite
OMS_PORT=3001
# Opcjonalnie: tylko dokładna lista zaufanych reverse proxy (IP albo CIDR), po przecinku.
# Brak/pusta wartość oznacza false. true, *, whitespace, CIDR /0 i zestaw CIDR
# pokrywający całą rodzinę adresów odmawiają startu.
# IPv4-mapped IPv6 (np. ::ffff:127.0.0.1) jest odrzucane; użyj natywnego IPv4.
# OMS_TRUST_PROXY=127.0.0.1,::1
# OMS_SPRZEDAWCA_NIP=
# OMS_RACHUNEK=
# Opcjonalnie (PRZ-069): publiczny adres panelu do linków zaproszeń i resetu hasła w mailach,
# sam schemat i host, bez ścieżki. Brak = linki tylko przez „Pokaż link”.
# OMS_ADRES_PANELU=https://panel.example.pl
# OMS_SPRZEDAWCA_BDO=
# OMS_BANK=

# Wspólne HTTP, gdy modulWeb jest włączony. Brak obu blokuje konfigurację web.
# To nie aliasy OMS_AUTH_USER/PASS: tamte występują wyłącznie w testach.
# OMS_USER=
# OMS_PASS=

# Kanały. Pusta lista służy temu projektowi próby bez integracji.
# NIE stanowi potwierdzenia kompletnej konfiguracji produkcyjnej (decyzja D01).
OMS_KANALY=[]
OMS_POLLER_MS=120000
# Neutralne przykładowe definicje do użycia dopiero po decyzji o integracjach:
# OMS_KANALY=[{"klucz":"demo_woo","typ":"woo","prefiks":"SHOP_DEMO"},{"klucz":"demo_allegro","typ":"allegro","prefiks":"ALLEGRO_DEMO"}]
# Prefiksy są dowolne zgodne z ^[A-Z][A-Z0-9_]*$, a nie narzucone przez typ.
# Dla Woo wymagane są URL/CK/CS/MAPOWANIE; OD jest opcjonalną datą początkową RRRR-MM-DD.
# Brak CK i CS pomija kanał; jeden ustawiony wymaga całej sekcji.
# W proba CK/CS muszą pozostać nieustawione.

# Cenniki „Dodaj z magazynu” (PRZ-060). Bez zmiennej: sklepy Woo z OMS_KANALY, pierwszy = domyślny.
# Allegro nigdy nie jest cennikiem. Pierwszy wpis listy = cennik domyślny.
# OMS_CENNIKI=[{"kanal":"demo_woo","nazwa":"Sklep detaliczny"}]

# Znak w belce panelu (PRZ-060). Bez zmiennych: neutralny znak z paczki, alt="".
# OMS_LOGO_PLIK — PNG na wolumenie danych, podawany pod /public/favicon-192.png; brak pliku = odmowa startu.
# OMS_LOGO_PLIK=/data-oms/marka/logo-192.png
# OMS_LOGO_ALT=
# SHOP_DEMO_CK=
# SHOP_DEMO_CS=
# SHOP_DEMO_URL=
# SHOP_DEMO_MAPOWANIE={"instancje":{},"poPozycji":[]}
# MAPOWANIE powyżej jest tylko pustym szkieletem JSON, nie mapą dostaw instalacji.
# SHOP_DEMO_OD=
# SHOP_DEMO_HISTORIA_KONTO_APILO=
# HISTORIA_KONTO_APILO jest wymagane dla samodzielnego importu historii Woo.

# Dla Allegro wymagane CLIENT_ID/CLIENT_SECRET/USER_AGENT/OD; UA ma postać nazwa/wersja (+https://host), OD jest wymaganym RRRR-MM-DD.
# W proba poświadczenia muszą pozostać nieustawione.
# ALLEGRO_DEMO_CLIENT_ID=
# ALLEGRO_DEMO_CLIENT_SECRET=
# ALLEGRO_DEMO_API=https://api.allegro.pl
# ALLEGRO_DEMO_AUTH=https://allegro.pl/auth/oauth
# ALLEGRO_DEMO_USER_AGENT=
# ALLEGRO_DEMO_OD=

# Historia i WDT: pustki produkcyjnej nie potwierdzamy za właściciela (D03).
# Format list: wartości oddzielone przecinkami, bez firmowych defaultów.
# Brak obu list WDT daje pusty Set. Lista kanoniczna i alias muszą być równoważne.
# OMS_KLIENCI_WDT=
# OMS_HISTORIA_MAILE_WDT=
# OMS_HISTORIA_MAILE_TESTOWE=
# OMS_HISTORIA_DOMENY_TESTOWE=
# OMS_HISTORIA_PREFIKSY_TESTOWE=
# OMS_HISTORIA_NAZWY_TESTOWE=
# Tylko jawny historyczny helper migracji; pełny bootstrap go nie uruchamia:
# OMS_KLIENCI_ZBIORCZY=

# Raporty: konto/granice opisują dane tej instalacji (D08), nie datę wydania.
# Konto historii raportów jest niezależne od konta historii pojedynczego Woo.
# Daty mają format RRRR-MM-DD; brak daty pozostaje null.
# OMS_RAPORTY_KONTO_HISTORII=
# OMS_RAPORTY_PODLOGA_ZWROTOW=
# OMS_STATYSTYKI_PIERWSZY_DZIEN=
# OMS_RAPORTY_SKLEP_HISTORII=
# OMS_RAPORTY_DATA_IMPORTU_HISTORII=
# Niepoprawny JSON odmawia nazwanym błędem bez wypisania wejścia.
OMS_RAPORTY_NAZWY_KANALOW={}

# Faktury. Katalog proform wymagany także bez klucza inFaktu.
OMS_PROFORMY_KATALOG=/data-oms/proformy
# INFAKT_API_KEY=
# INFAKT_API_URL=https://api.infakt.pl/api
# INFAKT_ARCHIWUM=

# Koszty KSeF. Nie odkomentowuj API/NIP/ARCHIWUM bez tokenu:
# niepusta rozpoczęta sekcja bez tokenu odmawia konfiguracji.
# KSEF_TOKEN=
# KSEF_NIP=
# KSEF_API=https://api.ksef.mf.gov.pl/v2
# KSEF_ARCHIWUM=

# GUS. Klucz jest bramką usługi i jest zabroniony w proba.
# GUS_KLUCZ=
# GUS_URL=https://wyszukiwarkaregon.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc

# Adres nadawcy: wspólny dla DPD, InPost, specyfikacji, proform i potwierdzenia wywozu.
# Nazwa i ulica są wymagane przy generacji dokumentów; pełny adres przy włączeniu kuriera.
# Nie kopiuj do tych pól danych prawnych bez ustalenia adresu nadawcy (D05).
# DPD_NADAWCA_NAZWA=
# DPD_NADAWCA_ULICA=
# DPD_NADAWCA_KOD=
# DPD_NADAWCA_MIASTO=
# DPD_NADAWCA_KRAJ=PL
# DPD_NADAWCA_TELEFON=
# DPD_NADAWCA_EMAIL=

# DPD: dosłownie pusty URL oznacza brak ustawienia i klient pozostaje wyłączony.
# Niepusty URL z whitespace odmawia; aktywny DPD wymaga pozostałych pól.
# Zakomentowane puste pola nie ustawiają env.
# DPD_URL=
# DPD_LOGIN=
# DPD_PASSWORD=
# DPD_FID=
# DPD_INFO_URL=
# DPD_INFO_CHANNEL=

# InPost włącza dopiero token; wymaga dodatniej organizacji i adresu nadawcy.
# Telefon i e-mail są wymagane dopiero przed nadaniem.
# INPOST_TOKEN=
# INPOST_ORGANIZACJA=
# INPOST_URL=https://api-shipx-pl.easypack24.net/v1
# INPOST_PACZKOMAT_NADAWCZY=

# Etykiety: na pinie starsze DIR ma pierwszeństwo nad KATALOG.
# Potwierdzić wolumen i reakcję na dwie różne ścieżki (D04).
# OMS_ETYKIETY_DIR=
OMS_ETYKIETY_KATALOG=/var/lib/panel/etykiety
OMS_PRZESYLKI_ODSTEP_MS=3600000
OMS_PODJAZDY_ODSTEP_MS=600000

# SMTP: CAŁA sekcja zakomentowana oznacza pocztę wyłączoną.
# Sama obecność SMTP_PORT lub MAIL_FROM wymaga też HOST/USER/PASS.
# W proba SMTP_USER/PASS muszą pozostać nieustawione.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_PORT=465
# MAIL_FROM=
# Brak MAIL_FROM po aktywacji SMTP wybiera SMTP_USER; musi być adresem e-mail.

# Oprawa nie włącza SMTP. Stopka obsługuje rzeczywiste nowe linie;
# zapis wielowierszowy zależy od zewnętrznego loadera.
# OMS_MAIL_MARKA=
# OMS_MAIL_STOPKA=

# Nazwy zadeklarowane bez niezależnego konfiguratora klienta:
# ALLEGRO_CLIENT_ID=
# ALLEGRO_CLIENT_SECRET=
# WOO_CK=
# WOO_CS=
# APILO_CREDENTIALS_PATH=
# META_TOKEN=
# GA4_KLUCZ=
# Globalne Allegro są w guardzie próby faktur/wysyłki; Woo/Allegro mogą też
# być konkretną rodziną prefiksową przy P=WOO lub P=ALLEGRO.
# APILO/META/GA4 nie są aktywnymi modułami pełnej kompozycji tego pinu.

# Zegary wiadomości/KSeF/kosztów/ostrzeżeń mają stałe w kodzie.
# Nie istnieją osobne zmienne env do ich odstępów w tym commicie.
# Strefa kontenera; domenowe okna pobrania mają jawne Europe/Warsaw.
TZ=UTC

# Tylko harness testów, nie ustawienia instalacji produktu:
# OMS_AUTH_USER, OMS_AUTH_PASS, ALLEGRO_USER_AGENT,
# OMS_TEMP_PROBE_MODE, OMS_TEMP_WORKER_REPORT, OMS_TEST_API_SPY,
# LOCALAPPDATA, PATH, SystemRoot, TMPDIR, TEMP, TMP.

# W5: pełna konfiguracja modułów jest sprawdzana przed otwarciem DB.
